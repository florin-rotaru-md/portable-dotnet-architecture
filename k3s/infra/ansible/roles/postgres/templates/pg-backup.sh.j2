#!/usr/bin/env bash
# Nightly backup — dumps every user database, syncs to S3, and prunes old dumps.
set -euo pipefail

BACKUP_DIR="/opt/postgres/backups"
RETENTION_DAYS="{{ backup_retention_days }}"
STAMP="$(date +%Y%m%d-%H%M%S)"

DATABASES=$(psql -U postgres -tAc \
  "SELECT datname FROM pg_database WHERE datistemplate = false AND datname NOT IN ('postgres')")

for DB in $DATABASES; do
  DEST="${BACKUP_DIR}/${DB}_${STAMP}.dump"
  echo "[$(date -Iseconds)] Backing up ${DB} -> ${DEST}"
  pg_dump -Fc "$DB" > "$DEST"
  chmod 600 "$DEST"
done

AWS_ACCESS_KEY_ID="{{ s3_access_key }}" \
AWS_SECRET_ACCESS_KEY="{{ s3_secret_key }}" \
aws s3 sync "$BACKUP_DIR" "s3://{{ s3_bucket }}/postgres/" --endpoint-url "{{ s3_endpoint }}"

find "$BACKUP_DIR" -name "*.dump" -mtime +"$RETENTION_DAYS" -delete

echo "[$(date -Iseconds)] Backup complete - $(echo "$DATABASES" | wc -w) database(s)"
