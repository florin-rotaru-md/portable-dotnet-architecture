on windows 11 host:
---
# Remove stale host keys after rebuilding VMs
ssh-keygen -R 192.168.0.21
ssh-keygen -R 192.168.0.22
ssh-keygen -R 192.168.0.23

# Optional: create an external Hyper-V switch once
# PowerShell (Run as Administrator)
# Get-NetAdapter
# New-VMSwitch -Name "External-LAN" -NetAdapterName "Ethernet" -AllowManagementOS $true

# Optional: create VMs from PowerShell if you do not want to use Hyper-V Manager
# Topology: control-ubuntu (Ansible), app-ubuntu (Nginx + .NET),
#           postgres-ubuntu (PostgreSQL), monitoring-ubuntu (Docker: Loki + Grafana)
#
# New-VM -Name "control-ubuntu"    -Generation 2 -MemoryStartupBytes 4GB  -NewVHDPath "D:\Hyper-V\control-ubuntu.vhdx"    -NewVHDSizeBytes 40GB  -SwitchName "External-LAN"
# New-VM -Name "app-ubuntu"        -Generation 2 -MemoryStartupBytes 8GB  -NewVHDPath "D:\Hyper-V\app-ubuntu.vhdx"        -NewVHDSizeBytes 100GB -SwitchName "External-LAN"
# New-VM -Name "postgres-ubuntu"   -Generation 2 -MemoryStartupBytes 4GB  -NewVHDPath "D:\Hyper-V\postgres-ubuntu.vhdx"   -NewVHDSizeBytes 60GB  -SwitchName "External-LAN"
# New-VM -Name "monitoring-ubuntu" -Generation 2 -MemoryStartupBytes 4GB  -NewVHDPath "D:\Hyper-V\monitoring-ubuntu.vhdx" -NewVHDSizeBytes 40GB  -SwitchName "External-LAN"

# Optional but recommended: dedicated Postgres backup disk on a different physical drive
# ---------------------------------------------------------------------------------------
# Goal: keep Postgres dumps on a disk that is NOT the same physical drive as the
# OS VHDX of postgres-ubuntu. The VM still sees a normal /dev/sdb block device.
# Point the VHDX path below to a folder on the SECOND physical disk in the host.
#
# PowerShell (Run as Administrator):
# New-Item -ItemType Directory -Force -Path "E:\Hyper-V\backups" | Out-Null
# New-VHD -Path "E:\Hyper-V\backups\postgres-ubuntu-pgbackups.vhdx" `
#         -SizeBytes 100GB -Dynamic
# Add-VMHardDiskDrive -VMName "postgres-ubuntu" `
#         -Path "E:\Hyper-V\backups\postgres-ubuntu-pgbackups.vhdx" `
#         -ControllerType SCSI
#
# Notes:
# - Use a Dynamic VHDX on a different *physical* disk than the OS VHDX.
# - Do NOT rely on Hyper-V checkpoints as a substitute for off-host backups.
# - For true pass-through: take the disk Offline in Disk Management first,
#   then Add-VMHardDiskDrive with -DiskNumber instead of -Path.

on target vm (app-ubuntu — 192.168.0.21):
---
# Install SSH if missing and bring the OS current
sudo apt update && \
sudo apt upgrade -y && \
sudo apt install -y openssh-server cloud-guest-utils

# If the virtual disk was expanded after install, no manual growing is needed:
# the common role grows partition/LVM/filesystem on every playbook run
# (grow_root_filesystem in main.yml).

# If you will connect as the default Ubuntu user on first bootstrap,
# verify it has passwordless sudo or knows the sudo password.

echo 'devops ALL=(ALL) NOPASSWD: ALL' | sudo tee /etc/sudoers.d/devops
sudo chmod 440 /etc/sudoers.d/devops

on target vm (postgres-ubuntu — 192.168.0.22):
---
# Install SSH if missing and bring the OS current
sudo apt update && \
sudo apt upgrade -y && \
sudo apt install -y openssh-server cloud-guest-utils

# Disk growth is handled by the common role on every playbook run — see the
# app-ubuntu note above.

# Optional: verify the dedicated Postgres backup disk is visible and unformatted.
# It should appear as /dev/sdb with no partitions and an empty TYPE.
# The ansible postgres role will mkfs.ext4 + mount it at /mnt/pgbackups and
# add the fstab entry. Do NOT pre-format it manually.
lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT
sudo blkid /dev/sdb || echo "empty, ok"

echo 'devops ALL=(ALL) NOPASSWD: ALL' | sudo tee /etc/sudoers.d/devops
sudo chmod 440 /etc/sudoers.d/devops

on target vm (monitoring-ubuntu — 192.168.0.23):
---
# Install SSH if missing and bring the OS current
sudo apt update && \
sudo apt upgrade -y && \
sudo apt install -y openssh-server

echo 'devops ALL=(ALL) NOPASSWD: ALL' | sudo tee /etc/sudoers.d/devops
sudo chmod 440 /etc/sudoers.d/devops

on control vm (control-ubuntu):
---
sudo apt update && \
sudo apt upgrade -y && \
sudo apt install -y git curl python3 python3-pip python3-venv pipx openssh-client && \
mkdir -p ~/.local/bin && \
echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.bashrc && \
export PATH="$HOME/.local/bin:$PATH" && \
pipx ensurepath && \
pipx install --include-deps ansible

# SSH key — generate once, reuse across rebuilds / disaster recovery
# Option A: Linux / WSL / macOS
test -f ~/.ssh/id_ed25519_devops || \
  ssh-keygen -t ed25519 -C "devops" -f ~/.ssh/id_ed25519_devops -N ""

# Option B: Windows (PowerShell — OpenSSH built-in, Windows 10 1809+)
# if (-not (Test-Path "$env:USERPROFILE\.ssh\id_ed25519_devops")) {
#   ssh-keygen -t ed25519 -C "devops" -f "$env:USERPROFILE/.ssh/id_ed25519_devops" -N '""'
# }

# Backup — run once after generation; store securely (password manager, encrypted USB, vault):
# cp ~/.ssh/id_ed25519_devops     ~/id_ed25519_devops.bak
# cp ~/.ssh/id_ed25519_devops.pub ~/id_ed25519_devops.pub.bak

# Restore on a new / recovered control VM (avoids re-running ssh-copy-id on all targets):
#   mkdir -p /home/devops/.ssh && chmod 700 /home/devops/.ssh
#   echo '-----BEGIN OPENSSH PRIVATE KEY...' >> /home/devops/.ssh/id_ed25519_devops
#   echo 'ssh-ed25519 AAAA...' >> /home/devops/.ssh/id_ed25519_devops.pub

chmod 600 /home/devops/.ssh/id_ed25519_devops
chmod 644 /home/devops/.ssh/id_ed25519_devops.pub
chown -R devops:devops /home/devops/.ssh


# Copy the controller key to the initial admin account on all target VMs.
# Replace 'devops' with your first user if different.
ssh-copy-id -i ~/.ssh/id_ed25519_devops.pub devops@192.168.0.21
ssh-copy-id -i ~/.ssh/id_ed25519_devops.pub devops@192.168.0.22
ssh-copy-id -i ~/.ssh/id_ed25519_devops.pub devops@192.168.0.23

mkdir -p ~/src && cd ~/src && \
git clone https://github.com/florin-rotaru-md/portable-dotnet-architecture

cd ~/src/portable-dotnet-architecture && \
cp hyper-v/files/hosts.ini native/infra/ansible/inventory/hosts.ini && \
cp hyper-v/files/main.yml native/infra/ansible/inventory/group_vars/all/main.yml && \
cp hyper-v/files/vault.yml.example native/infra/ansible/inventory/group_vars/all/vault.yml

# Edit the prepared files
nano ~/src/portable-dotnet-architecture/native/infra/ansible/inventory/hosts.ini
nano ~/src/portable-dotnet-architecture/native/infra/ansible/inventory/group_vars/all/vault.yml
# nano ~/src/portable-dotnet-architecture/native/infra/ansible/inventory/group_vars/all/main.yml

cat << 'EOF' > ~/src/portable-dotnet-architecture/native/infra/ansible/inventory/group_vars/all/main.yml
---
# ── Ansible service account ────────────────────────────────────────────────────
ansible_user: devops
# ansible_ssh_public_key (+ optional ansible_ssh_extra_public_keys) come from vault.yml

# Once EVERY key you rely on is listed in vault.yml, flip to true: keys not in
# the list are removed on the next run — key rotation = one playbook run.
ssh_authorized_keys_exclusive: false

# Grow the root partition/LVM/filesystem into whatever the hypervisor granted —
# a no-op when nothing changed, so it runs on every host, every run. LVM layouts
# only: cloud-image guests grow themselves via cloud-init — set false there
# (proxmox-homelab Stage 11).
grow_root_filesystem: true

# ── Infrastructure ─────────────────────────────────────────────────────────────
app_user: devops
app_log_root: /var/log
apps_root:    /opt/apps
dotnet_version: "10.0"

# ── Postgres ───────────────────────────────────────────────────────────────────
postgres_version: "18"
postgis_major_version: "3"
postgres_user:    postgres
backup_retention_days: 7

# Minor releases (18.1 -> 18.2) install automatically via unattended-upgrades
# with the PGDG origin; majors always require a deliberate postgres_version bump.
postgres_auto_minor_upgrades: true

# Nightly logical dump schedule — keep it BEFORE any VM-image/checkpoint backup.
postgres_backup_hour:   "2"
postgres_backup_minute: "15"

# IP that the app VM uses to reach the postgres VM (postgres-ubuntu — 192.168.0.22).
postgres_host: "192.168.0.22"

# Subnet allowed to connect to PostgreSQL over TCP.
# The postgres role opens UFW port 5432 and adds a pg_hba.conf entry for this CIDR.
postgres_app_cidr: "192.168.0.0/24"

# ── WAL streaming to a third box (optional) ────────────────────────────────────
# Streams the write-ahead log to an always-on receiver (pg_receivewal), so an
# unplanned failover loses seconds instead of the VM-replication interval.
# Receiver setup + the recovery procedure: proxmox-homelab/ha/10b-wal-stream.md
postgres_wal_stream_enabled: false
postgres_wal_stream_user: "walreceiver"
postgres_wal_stream_slot: "wal_archive"
# The receiver's address as a CIDR, e.g. "192.168.0.5/32" (the QDevice)
postgres_wal_stream_cidr: ""
# Safety valve: max WAL retained for a disconnected receiver, so a dead
# receiver breaks the stream instead of filling the database disk.
postgres_max_slot_wal_keep_size: "10GB"
# postgres_wal_stream_password comes from vault.yml when enabled

# ── Postgres backup disk (dedicated VHDX on a different physical drive) ───────
# Attach the second VHDX to postgres-ubuntu (not app-ubuntu).
# Comment these out to keep backups on the OS disk under /opt/postgres/backups.
postgres_backup_device: /dev/sdb
postgres_backup_mount:  /mnt/pgbackups
postgres_backup_label:  pgbackups

# ── Cloudflare (optional) ──────────────────────────────────────────────────────
use_cloudflared: true

# ── Loki + Grafana (optional, Docker on dedicated monitoring VM) ─────────────
use_loki_grafana: true
monitoring_target: monitoring
monitoring_root: /opt/monitoring
monitoring_bind_address: "127.0.0.1"
loki_bind_address: "0.0.0.0"
grafana_bind_address: "0.0.0.0"
monitoring_allowed_cidr: "192.168.0.0/24"
loki_image: "grafana/loki:3.0.0"
grafana_image: "grafana/grafana:11.1.4"
grafana_port: 3000
loki_port: 3100
grafana_admin_user: admin
grafana_loki_datasource_name: "Loki"
grafana_loki_datasource_url: "http://loki:3100"
grafana_loki_is_default: true

# ── Grafana Alloy on app VM (logs -> Loki on monitoring VM) ──────────────────
alloy_http_port: 12345
alloy_logs_root: "{{ app_log_root }}"
alloy_log_glob: "*.log"
# alloy_loki_url: "http://192.168.0.23:3100/loki/api/v1/push"

# ── Firewall ───────────────────────────────────────────────────────────────────
ufw_allowed_tcp_ports:
  - "22"
  - "80"
  - "443"

# ── Native multi-app mode (recommended) ───────────────────────────────────────
health_max_attempts: 16
health_interval_seconds: 4

applications:
  - name:          api.waa.ro
    log_dir_name:  api.waa.ro
    assembly:      Waa.Server
    domain:        api.waa.ro
    port_blue:     5000
    port_green:    5001
    # Optional per-app override:
    # health_max_attempts: 16
    # health_interval_seconds: 4
    drain_seconds: 32
    repo_url:      "https://github.com/florin-rotaru-md/statics.git"
    repo_branch:   "master"
    project_path:  "Apps/Waa/Waa.Server/Waa.Server.csproj"
    headless_browser: true
    repo_token:    "{{ app_repo_token }}"
    appsettings_override:
      Serilog:
        Using:
          - Serilog.Sinks.File
          - Serilog.Formatting.Compact
        MinimumLevel:
          Default: Information
          Override:
            Microsoft: Warning
            System: Warning
        Enrich:
          - FromLogContext
          - WithMachineName
          - WithThreadId
        WriteTo:
          - Name: File
            Args:
              path: "{{ app_log_root }}/api.waa.ro/app.log"
              rollingInterval: Day
              formatter: "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
              shared: true
              buffered: false
              rollOnFileSizeLimit: true
              fileSizeLimitBytes: 104857600
              retainedFileCountLimit: 14
        Properties:
          service: api.waa.ro
          env: production
      ConnectionStrings:
        App:            "Host={{ postgres_host }};Port=5432;Database=waa_ro_app;Username={{ postgres_user }};Password={{ postgres_password }};Pooling=true"
        Users:          "Host={{ postgres_host }};Port=5432;Database=waa_ro_users;Username={{ postgres_user }};Password={{ postgres_password }};Pooling=true"
        DataProtection: "Host={{ postgres_host }};Port=5432;Database=waa_ro_dp;Username={{ postgres_user }};Password={{ postgres_password }};Pooling=true"
      # FileStorage:
      #   BaseDirectory: "/data/files"
      # UiClient:
      #   Urls:
      #     SignInWithToken: "https://www.example.com/auth/sign-in"
    env:
      ASPNETCORE_FORWARDEDHEADERS_ENABLED: "true"

#   - name:          admin.waa.ro
#     assembly:      Waa.Admin
#     domain:        admin.waa.ro
#     port_blue:     5010
#     port_green:    5011
#     drain_seconds: 30
#     repo_url:      "https://github.com/florin-rotaru-md/waa-server.git"
#     repo_branch:   "master"
#     project_path:  "src/Waa.Admin/Waa.Admin.csproj"
#     repo_token:    "{{ app_repo_token }}"
#     appsettings_override:
#       ConnectionStrings:
#         Main: "Host={{ postgres_host }};Port=5432;Database=waa_ro_admin;Username={{ postgres_user }};Password={{ postgres_password }};Pooling=true"
EOF

# First bootstrap using the initial Ubuntu user.
# Play 1 targets [postgres] (postgres-ubuntu), Play 2 targets [app] (app-ubuntu).
# If root SSH is enabled in your environment, replace -u ubuntu with -u root.
cd ~/src/portable-dotnet-architecture/native/infra/ansible && \
ansible-playbook playbooks/bootstrap.yml -u ubuntu --ask-become-pass

# Normal path after the first run: devops user + SSH key auth
cd ~/src/portable-dotnet-architecture/native/infra/ansible && \
ansible-playbook playbooks/bootstrap.yml

# Run only Play 2 (hosts: app) when you need app-only changes.
# Example: reconfigure Nginx/.NET/app without touching postgres.
cd ~/src/portable-dotnet-architecture/native/infra/ansible && \
ansible-playbook playbooks/bootstrap.yml --limit app

# Run only Play 3 (hosts: monitoring) for Loki/Grafana changes.
cd ~/src/portable-dotnet-architecture/native/infra/ansible && \
ansible-playbook playbooks/bootstrap.yml --limit monitoring

# First bootstrap variant (if you still connect with the initial Ubuntu user):
cd ~/src/portable-dotnet-architecture/native/infra/ansible && \
ansible-playbook playbooks/bootstrap.yml -u ubuntu --ask-become-pass --limit app

# If vault.yml is encrypted:
# ansible-vault encrypt inventory/group_vars/all/vault.yml
