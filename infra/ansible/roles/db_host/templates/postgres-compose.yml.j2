services:
  postgres:
    image: postgres:{{ postgres_version }}
    container_name: postgres
    restart: unless-stopped
    environment:
      POSTGRES_DB: appdb
      POSTGRES_USER: appuser
      POSTGRES_PASSWORD: replace-me
    volumes:
      - /opt/postgres/data:/var/lib/postgresql/data
      - /opt/postgres/backups:/backups
    ports:
      - "5432:5432"
