---
# ── Cluster ────────────────────────────────────────────────────────────────────
cluster_name: prod
k3s_version:  v1.30.4+k3s1
flux_version: v2.3.0

# ── Postgres (on a separate Proxmox VM, internal bridge IP) ───────────────────
postgres_version:    "18"
postgres_private_ip: "10.10.0.50"   # internal bridge IP of the Postgres VM
postgres_user:       appuser
# postgres_password comes from vault.yml

# Automatic MINOR upgrades via unattended-upgrades + PGDG origin (majors never
# arrive this way — bumping postgres_version is always deliberate).
postgres_auto_minor_upgrades: true

# ── Postgres tuning (conf.d/10-tuning.conf) ───────────────────────────────────
# max_connections is policy, not RAM: it follows the Maximum Pool Size caps in
# the connection strings, and the window that sizes it is a deploy, not rush
# hour:
#
#   steady     = the sum, over every deployment sharing this cluster, of that
#                deployment's own per-instance pools
#   worst case = steady + the largest single deployment's pools, because for
#                the length of a deploy the outgoing and incoming instances of
#                that one deployment both hold their own (a blue/green drain,
#                a rolling update — the same window)
#
# read against max_connections less superuser_reserved_connections (Postgres'
# default is 3), with headroom left for psql/monitoring/backup. Not one
# per-instance total multiplied by an application count and doubled, which this
# file used to say: that charges the smallest deployment at the largest one's
# size and assumes every application drains at the same moment. That all-drain
# sum is worth computing as a secondary check; it is not the verdict.
#
# Deploys taken one at a time are what make the worst case the worst case, and
# that stays an honour system: whatever serialises deploys does, not the
# database. A per-deployment non-superuser role with its own CONNECTION LIMIT
# is what would enforce it. Where every deployment instead connects as
# postgres, a superuser, both superuser_reserved_connections and
# ALTER DATABASE ... CONNECTION LIMIT are unenforced and the starvation hole is
# open: one application can take every slot on the server, starve the others
# and lock the operator out of the database it saturated. Subtracting the
# reserve keeps the budget conservative rather than reserving anything from
# anybody; the only cap that binds is Maximum Pool Size on each connection
# string, which is client-side and always enforced.
#
# A RAM upgrade does not move it; another deployment does. The live estate's
# own worked table lives in the live inventory and in native/example;
# perf/load-drill.sh recomputes it from scenarios/endpoints.json and fails the
# run when it stops fitting.
postgres_max_connections: 400

# Everything else derives from the VM's RAM on every playbook run
# (shared_buffers 25%, effective_cache_size 75%, work_mem and
# maintenance_work_mem step up at 48GB) — growing the VM and re-running
# bootstrap is the whole tuning upgrade. Override only when the derived value
# is wrong for the workload:
# postgres_shared_buffers:           "1GB"
# postgres_effective_cache_size:     "3GB"
# postgres_work_mem:                 "32MB"
# postgres_maintenance_work_mem:     "1GB"
# postgres_max_wal_size:             "4GB"
# postgres_random_page_cost:         "1.1"
# postgres_effective_io_concurrency: "200"
# postgres_wal_compression:          "lz4"

# Nightly S3 dump schedule (cron on the postgres VM). Keep it BEFORE the
# Proxmox vzdump job so every VM image contains a fresh dump.
postgres_backup_hour:   "2"
postgres_backup_minute: "15"

# ── S3-compatible backup ───────────────────────────────────────────────────────
# Works with any S3-compatible endpoint: AWS, Hetzner Object Storage, Backblaze B2, MinIO, etc.
s3_bucket:   your-cluster-backups
s3_endpoint: https://s3.amazonaws.com
s3_region:   eu-central-1
# s3_access_key and s3_secret_key come from vault.yml
backup_retention_days: 30

# ── FluxCD Git source ─────────────────────────────────────────────────────────
# Flux will watch the same k3s/flux/ path as the cloud k3s setup.
flux_git_repo:   https://github.com/your-org/portable-dotnet-architecture
flux_git_branch: master
# flux_git_token comes from vault.yml (private repos only)

# ── Ansible service account ────────────────────────────────────────────────────
ansible_user: ops
# ansible_ssh_public_key comes from vault.yml — paste your controller's public key there

# Additional authorized keys (workstation, break-glass kept offline). One key is
# a single point of failure.
# ansible_ssh_extra_public_keys:
#   - "ssh-ed25519 AAAA... workstation"
#   - "ssh-ed25519 AAAA... break-glass"
#   - "ssh-ed25519 AAAA... cloud-init"          # see the note below

# The list must also contain every key that was seeded OUTSIDE Ansible and is
# still a way in — here that's ssh_public_key from terraform.tfvars, which
# cloud-init put on every VM at creation, plus any hypervisor root key you
# authorized by hand. They don't feel like "identities", which is exactly why
# the first exclusive run deletes them and takes your way in with them.

# Once EVERY key you rely on is listed above, flip to true: keys not in the list
# are removed on the next run — rotating a compromised key = one playbook run.
# Check what is actually authorized first:
#   ansible all -m command -a 'cat ~/.ssh/authorized_keys' -b --become-user ops
ssh_authorized_keys_exclusive: false

# The common role pins PasswordAuthentication no in sshd, so a console password
# (Proxmox --cipassword) never opens password auth over SSH.
ssh_disable_password_auth: true
