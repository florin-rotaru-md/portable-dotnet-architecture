on local pc
---
# Scratch snippets for the controller key. Two rules the per-project READMEs
# spell out, and this file is easy to use without reading them:
#   1. The private half belongs in a password manager the day it is created —
#      unless it was generated on the machine that uses it and is meant to have
#      no copy at all (proxmox-homelab 0.5 explains which case is which).
#   2. This public key was seeded OUTSIDE Ansible. Put it in
#      ansible_ssh_extra_public_keys before setting
#      ssh_authorized_keys_exclusive: true, or the first run deletes it.

# ── Generate SSH key (run once; reuse across all VMs) ──────────────────────────
# Windows (PowerShell — OpenSSH built-in, Windows 10 1809+)
if (-not (Test-Path "$env:USERPROFILE\.ssh\id_ed25519_devops")) {
  ssh-keygen -t ed25519 -C "devops" -f "$env:USERPROFILE/.ssh/id_ed25519_devops" -N '""'
}
# Print public key — copy this value; you'll need it during VM creation
Get-Content "$env:USERPROFILE\.ssh\id_ed25519_devops.pub"

# Linux / WSL / macOS
# test -f ~/.ssh/id_ed25519_devops || \
#   ssh-keygen -t ed25519 -C "devops" -f ~/.ssh/id_ed25519_devops -N ""
# cat ~/.ssh/id_ed25519_devops.pub

# ── Import the key when creating the VM ───────────────────────────────────────
# Ubuntu Server installer (subiquity):
#   During "SSH Setup" step → enable "Install OpenSSH server"
#   → "Import SSH identity" → choose "No" for GitHub import
#   → paste the public key printed above into "Authorised keys"
#
# Alternatively, after VM creation, on the target VM run:
#   mkdir -p /home/devops/.ssh && chmod 700 /home/devops/.ssh
#   echo '-----BEGIN OPENSSH PRIVATE KEY...' >> /home/devops/.ssh/id_ed25519_devops
#   echo 'ssh-ed25519 AAAA...' >> /home/devops/.ssh/id_ed25519_devops.pub
#   chmod 600 /home/devops/.ssh/id_ed25519_devops
#   chmod 644 /home/devops/.ssh/id_ed25519_devops.pub
#   chown -R devops:devops /home/devops/.ssh
#
# Verify connectivity before running Ansible:
#   ssh -i ~/.ssh/id_ed25519_devops devops@192.168.0.22
#   ssh -i %userprofile%/.ssh/id_ed25519_devops devops@192.168.0.22

ssh-keygen -R 192.168.0.22
