#!/usr/bin/env bash
# deploy.sh — Build from Git and deploy via blue/green slot swap.
#
# First deploy:
#   deploy.sh --repo-url https://github.com/org/repo.git \
#             --branch master \
#             [--token ghp_xxx] \
#             --project-path src/MyApp/MyApp.csproj
#
# Subsequent deploys (uses cached repo/project; the token resolves from
# --token → APP_REPO_TOKEN → config/repo-token, so normally none is passed):
#   deploy.sh [--branch master]
#
set -euo pipefail

APP_NAME="{{ app_name }}"
APPS_ROOT="{{ apps_root }}"
APP_ROOT="$APPS_ROOT/$APP_NAME"
SCRIPTS_DIR="$APP_ROOT/scripts"
RUNTIME_DIR="$APP_ROOT/runtime"
BUILD_DIR="$APP_ROOT/build"
# Where the application rolls its own log. Not the journal: the journal has the process's stderr,
# this has the exception.
LOG_DIR="{{ app_log_dir }}"
DRAIN_SECONDS="{{ drain_seconds }}"
PORT_BLUE="{{ app_port_blue }}"
PORT_GREEN="{{ app_port_green }}"
HEALTH_PATH="{{ app_health_path }}"
HEALTH_MAX_ATTEMPTS="{{ app_health_max_attempts }}"
HEALTH_INTERVAL_SECONDS="{{ app_health_interval_seconds }}"

REPO_URL=""
REPO_BRANCH=""
REPO_TOKEN="${APP_REPO_TOKEN:-}"
PROJECT_PATH=""

# ── Argument parsing ─────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo-url)     REPO_URL="$2";     shift 2 ;;
    --branch)       REPO_BRANCH="$2";  shift 2 ;;
    --token)        REPO_TOKEN="$2";   shift 2 ;;
    --project-path) PROJECT_PATH="$2"; shift 2 ;;
    *) echo "Unknown argument: $1" >&2; exit 1 ;;
  esac
done

# ── Load / resolve config from cache ─────────────────────────────────────────
if [ -z "$REPO_URL" ] && [ -f "$RUNTIME_DIR/repo-url" ]; then
  REPO_URL=$(cat "$RUNTIME_DIR/repo-url")
fi
if [ -z "$REPO_URL" ]; then
  echo "Error: --repo-url is required on first deploy" >&2; exit 1
fi

if [ -z "$REPO_BRANCH" ]; then
  REPO_BRANCH=$(cat "$RUNTIME_DIR/repo-branch" 2>/dev/null || echo "master")
fi
if [ -z "$PROJECT_PATH" ] && [ -f "$RUNTIME_DIR/project-path" ]; then
  PROJECT_PATH=$(cat "$RUNTIME_DIR/project-path")
fi
if [ -z "$PROJECT_PATH" ]; then
  echo "Error: --project-path is required on first deploy" >&2; exit 1
fi

# Token fallback: Ansible renders the app's repo_token from vault.yml to
# config/repo-token (0600), so manual deploys don't need to supply one.
if [ -z "$REPO_TOKEN" ] && [ -f "$APP_ROOT/config/repo-token" ]; then
  REPO_TOKEN=$(cat "$APP_ROOT/config/repo-token")
fi

# Persist config (repo URL stored without token)
echo "$REPO_URL"     > "$RUNTIME_DIR/repo-url"
echo "$REPO_BRANCH"  > "$RUNTIME_DIR/repo-branch"
echo "$PROJECT_PATH" > "$RUNTIME_DIR/project-path"

# ── Determine slots ───────────────────────────────────────────────────────────
CURRENT_SLOT="$("$SCRIPTS_DIR/current-slot.sh")"
if [ "$CURRENT_SLOT" = "blue" ]; then
  TARGET_SLOT="green"
  TARGET_PORT="$PORT_GREEN"
  TARGET_SERVICE="${APP_NAME}-green"
  OLD_SERVICE="${APP_NAME}-blue"
else
  TARGET_SLOT="blue"
  TARGET_PORT="$PORT_BLUE"
  TARGET_SERVICE="${APP_NAME}-blue"
  OLD_SERVICE="${APP_NAME}-green"
fi

SLOT_DIR="$APP_ROOT/slots/$TARGET_SLOT"

print_service_diagnostics() {
  local svc="$1"
  echo "Service diagnostics for ${svc}:" >&2
  sudo systemctl --no-pager --full status "$svc" >&2 || true
  echo "Last 200 journal lines for ${svc}:" >&2
  sudo journalctl -u "$svc" -n 200 --no-pager >&2 || true
}

# The journal carries only what the process wrote to stderr — for a .NET host that is one line,
# and systemd ellipsizes it. Everything that says *why* (the exception with its stack, or the list
# of configuration sections a startup preflight found missing) is in the application's own rolling
# log, in a directory this script otherwise never looks at. An operator standing at a failed deploy
# had to know that file existed, know its name carries the slot and the date, and know the entries
# are CLEF — three facts that are not in the failure message. So the deploy prints it.
print_app_log_failure() {
  local slot="$1"
  local file
  file=$(ls -t "$LOG_DIR"/app-"$slot"-*.log 2>/dev/null | head -n 1) || true

  if [ -z "$file" ]; then
    echo "No application log for slot ${slot} under ${LOG_DIR}." >&2
    return 0
  fi

  local line
  line=$(grep -a '"@l":"Fatal"' "$file" | tail -n 1 || true)

  if [ -z "$line" ]; then
    echo "No Fatal entry in ${file}; last 20 lines:" >&2
    tail -n 20 "$file" >&2
    return 0
  fi

  echo "Last fatal entry in ${file}:" >&2
  if command -v python3 >/dev/null 2>&1; then
    printf '%s\n' "$line" | python3 -c '
import json, sys
entry = json.load(sys.stdin)
print("  " + (entry.get("@m") or entry.get("@mt") or ""))
for key, value in entry.items():
    if key not in ("@t", "@l", "@m", "@mt", "@x", "@i"):
        print(f"  {key} = {value}")
if entry.get("@x"):
    print(entry["@x"])
' >&2 || printf '%s\n' "$line" >&2
  else
    printf '%s\n' "$line" >&2
  fi
}

# nginx is still pointing at the slot that was serving before this run, so the half-deployed slot
# is reachable by nobody — and left running it crash-loops on whatever it died of, replaying its
# whole startup every ~20s. That is not harmless: the replay buries the first failure under
# seventy copies of itself, and each attempt opens the database pools again. Stopping it keeps
# the evidence readable and the connection budget intact; the files stay, so a re-run picks up
# where this one stopped.
stop_target_slot() {
  echo "Stopping ${TARGET_SERVICE} — nginx still serves ${CURRENT_SLOT}, so the idle slot must not crash-loop." >&2
  sudo systemctl stop "$TARGET_SERVICE" >/dev/null 2>&1 || true
}

fail_target_slot() {
  print_service_diagnostics "$TARGET_SERVICE"
  print_app_log_failure "$TARGET_SLOT"
  stop_target_slot
  exit 1
}

echo "──────────────────────────────────────"
echo "App:          $APP_NAME"
echo "Current slot: $CURRENT_SLOT  →  target: $TARGET_SLOT"
echo "Branch:       $REPO_BRANCH"
echo "Project:      $PROJECT_PATH"
echo "──────────────────────────────────────"

# ── Clone / pull repo (private GitHub repo; token required) ──────────────────
if [ -z "$REPO_TOKEN" ]; then
  echo "Error: GitHub token is required for repository deploys. Pass --token, set APP_REPO_TOKEN, or re-run the playbook so config/repo-token is rendered from vault.yml." >&2
  exit 1
fi

if [[ "$REPO_URL" != https://github.com/* ]]; then
  echo "Error: only https://github.com/... repository URLs are supported in private-token mode." >&2
  exit 1
fi

GH_BASIC_AUTH=$(printf 'x-access-token:%s' "$REPO_TOKEN" | base64 | tr -d '\n')

git_with_auth() {
  git -c "http.https://github.com/.extraheader=AUTHORIZATION: basic ${GH_BASIC_AUTH}" "$@"
}

if [ -d "$BUILD_DIR/.git" ]; then
  echo "Pulling latest from $REPO_BRANCH..."
  git -C "$BUILD_DIR" remote set-url origin "$REPO_URL"
  git_with_auth -C "$BUILD_DIR" fetch --depth=1 origin "$REPO_BRANCH"
  git -C "$BUILD_DIR" reset --hard "origin/$REPO_BRANCH"
else
  echo "Cloning $REPO_URL (branch $REPO_BRANCH)..."
  git_with_auth clone --branch "$REPO_BRANCH" --depth 1 "$REPO_URL" "$BUILD_DIR"
fi

if [ ! -f "$BUILD_DIR/$PROJECT_PATH" ]; then
  echo "Error: project path '$PROJECT_PATH' was not found in repository '$REPO_URL' (branch '$REPO_BRANCH')." >&2
  echo "Repository root: $BUILD_DIR" >&2
  echo "Top-level entries:" >&2
  find "$BUILD_DIR" -mindepth 1 -maxdepth 2 -type d | sed "s|$BUILD_DIR/||" | head -n 30 >&2 || true
  exit 1
fi

# ── Build ─────────────────────────────────────────────────────────────────────
echo "Publishing to $TARGET_SLOT slot..."
sudo systemctl is-active --quiet "$TARGET_SERVICE" && sudo systemctl stop "$TARGET_SERVICE" || true
find "${SLOT_DIR:?}" -mindepth 1 -delete 2>/dev/null || true

# Pin the RID: a framework-dependent publish without one copies every runtime's native assets
# into the slot (measured 2026-09-01: 363 MB, 255 MB of them Windows libSkiaSharp .pdb files;
# 60 MB with the RID). The RID follows the host's architecture, rendered at playbook time, so an
# arm64 host gets its own libSkiaSharp.so rather than the x64 one. The unit still runs
# `dotnet <App>.dll` (app-slot.service.j2); the apphost the publish also emits is unused.
dotnet publish "$BUILD_DIR/$PROJECT_PATH" \
  -c Release \
  -r {{ 'linux-arm64' if ansible_facts['architecture'] in ['aarch64', 'arm64'] else 'linux-x64' }} \
  --self-contained false \
  -o "$SLOT_DIR/"

# Keep the config files identical across blue/green slots. `dotnet publish` writes into the slot
# and does not remove what it did not put there, but a slot created after the last playbook run
# would otherwise start without them — the override file being the one that carries the connection
# strings, and config-bundle.json the one an empty database seeds itself from.
for config_file in appsettings.override.json config-bundle.json; do
  if [ -f "$APP_ROOT/config/$config_file" ]; then
    for slot in blue green; do
      cp "$APP_ROOT/config/$config_file" "$APP_ROOT/slots/$slot/$config_file"
      chown {{ app_user }}:{{ app_user }} "$APP_ROOT/slots/$slot/$config_file"
      chmod 600 "$APP_ROOT/slots/$slot/$config_file"
    done
  fi
done

# The loop above skips a file it cannot find, silently, which is right — not every app has an
# override and none of this is required for one that does not. What is not right is finding out
# about it from the application's boot: the process falls back to whatever appsettings.json
# committed (localhost connection strings, placeholder secrets), and the failure surfaces minutes
# later as a health check that never turns green. So the deploy says which of the two it copied
# and which it did not, before the service is asked to start.
for config_file in appsettings.override.json config-bundle.json; do
  if [ ! -f "$APP_ROOT/config/$config_file" ]; then
    echo "Note: $APP_ROOT/config/$config_file does not exist — the slot starts without it." >&2
  elif [ "$(tr -d '[:space:]' < "$APP_ROOT/config/$config_file")" = "{}" ]; then
    echo "Warning: $APP_ROOT/config/$config_file is empty ({})." >&2
    echo "         The playbook writes that when the inventory declares nothing for this app," >&2
    echo "         so an app that needs an override is about to boot without one." >&2
  fi
done

# ── Start idle slot ───────────────────────────────────────────────────────────
echo "Starting $TARGET_SERVICE..."
sudo systemctl start "$TARGET_SERVICE"

# Armed only now: before the start there is no service of ours to stop, and after the nginx switch
# the target slot is the one serving. Ctrl-C during the health check counts — that is how a slot
# was left restarting seventy times.
trap 'echo; stop_target_slot; exit 130' INT TERM

if ! sudo systemctl is-active --quiet "$TARGET_SERVICE"; then
  echo "Error: ${TARGET_SERVICE} did not become active after start." >&2
  fail_target_slot
fi

# ── Health check ──────────────────────────────────────────────────────────────
if ! "$SCRIPTS_DIR/health-check.sh" "http://127.0.0.1:${TARGET_PORT}" "$HEALTH_MAX_ATTEMPTS" "$HEALTH_INTERVAL_SECONDS" "$HEALTH_PATH"; then
  echo "Error: ${TARGET_SERVICE} never answered ${HEALTH_PATH} on port ${TARGET_PORT}." >&2
  fail_target_slot
fi

trap - INT TERM

# ── Switch Nginx ──────────────────────────────────────────────────────────────
"$SCRIPTS_DIR/switch-nginx.sh" "$TARGET_SLOT"

# ── Own the boot state ────────────────────────────────────────────────────────
# Exactly one slot per app may be enabled, and it is the one nginx now serves.
#
# Both used to be enabled, so a reboot of the host started BOTH slots of BOTH apps — on two
# different builds, draining the same queues and doubling the connection footprint against a pool
# the blue/green overlap already strains. Nothing failed; it just quietly ran twice.
#
# Enable after the switch, disable after the stop: at no point is the serving slot the disabled one,
# so a reboot in the middle of a deploy brings back something that works.
sudo systemctl enable "$TARGET_SERVICE" >/dev/null 2>&1 || true

# ── Drain & stop old slot ─────────────────────────────────────────────────────
echo "Draining old slot (${DRAIN_SECONDS}s)..."
sleep "$DRAIN_SECONDS"
sudo systemctl stop "$OLD_SERVICE"
sudo systemctl disable "$OLD_SERVICE" >/dev/null 2>&1 || true

# ── Log ───────────────────────────────────────────────────────────────────────
printf '%s | deploy | branch=%s | slot=%s\n' \
  "$(date -Iseconds)" "$REPO_BRANCH" "$TARGET_SLOT" \
  >> "$RUNTIME_DIR/deploy-history.log"

echo "✓ Deployment complete — $TARGET_SLOT is live"
