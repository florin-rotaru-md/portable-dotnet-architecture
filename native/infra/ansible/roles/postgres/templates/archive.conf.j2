# Managed by Ansible (roles/postgres) — continuous WAL archiving.
# Procedure and recovery: portable-dotnet-architecture/proxmox-lab/RECOVERY.md#backup-activation.
#
# Every completed WAL file is compressed into {{ postgres_wal_spool_dir | default('/opt/postgres/wal-spool') }}, from where the
# hypervisor running this VM pulls it and uploads it offsite. archive_timeout bounds how long a
# segment holding writes can stay unfinished; a server with no activity switches nothing, so a
# quiet night produces no files.
archive_mode = on
archive_timeout = {{ postgres_archive_timeout | default(60) }}
archive_command = '/opt/postgres/scripts/pg-wal-archive.sh "%p" "%f"'
