# Managed by Ansible (roles/postgres/templates/tuning.conf.j2) — edits here
# are overwritten on the next playbook run. Override via postgres_* group_vars.
#
# Sizes derive from the host's RAM at render time, so a RAM upgrade is just:
# grow the VM, re-run bootstrap — every value below follows on its own.
{% set ram_mb = ansible_facts['memtotal_mb'] | int %}

# Connection slots are policy, not RAM: sum the Maximum Pool Size of every
# connection string one application instance opens, add those per-application
# totals together for every application sharing this cluster, then add the
# largest single one back for the length of a blue/green drain (both slots of
# the deploying app hold their own pools for drain_seconds) and leave headroom
# for psql/monitoring/backup. Deploys taken one at a time are what make that
# the worst case, and it stays an honour system: the deploy playbook is what
# serialises them, not the database. See superuser_reserved_connections below
# for why no CONNECTION LIMIT binds anything here.
# A RAM upgrade does not move this number; adding an application does.
max_connections = {{ postgres_max_connections | default(128) }}

# The slots max_connections holds back for superusers. This is Postgres' own
# default, written out rather than inherited: every budget document subtracts
# it to reach the usable ceiling (400 - 3 = 397), and the load-drill box pins
# the same number (perf/postgres/conf.d/10-tuning.conf), so until now the two
# environments agreed by luck rather than by assertion.
# It buys nothing while the applications connect as a superuser — the
# reservation is unenforced for superusers, and so is
# ALTER DATABASE ... CONNECTION LIMIT. Per-application non-superuser roles,
# each with its own CONNECTION LIMIT, are what would close that; they do not
# exist here. Every application on this cluster connects as the postgres
# superuser and owns its own databases — chosen deliberately, for one backup
# and restore story, with the hole accepted: one application can consume every
# slot and starve the others. So the value below is written out to keep the
# published budget arithmetic honest, not because it reserves anything from
# anybody today. What actually bounds each application is Maximum Pool Size in
# its connection strings, which is client-side and always enforced.
superuser_reserved_connections = {{ postgres_superuser_reserved_connections | default(3) }}

# 25% of RAM, the dedicated-host starting point. Postgres reads also flow
# through the OS page cache, so pushing this higher mostly double-caches.
shared_buffers = {{ postgres_shared_buffers | default((ram_mb // 4) ~ 'MB', true) }}

# Planner hint only, allocates nothing: shared_buffers plus what the OS cache
# is expected to hold on a host that mostly runs Postgres.
effective_cache_size = {{ postgres_effective_cache_size | default((ram_mb * 3 // 4) ~ 'MB', true) }}

# Ceiling per sort/hash node, NOT per connection — one query can hold several,
# and hash nodes get work_mem x hash_mem_multiplier (2.0). Worst case is
# active queries x heavy nodes x that product, which is why the bigger tier
# waits for the RAM that arrives with it.
work_mem = {{ postgres_work_mem | default('64MB' if ram_mb >= 49152 else '32MB', true) }}

# VACUUM, CREATE INDEX, pg_restore.
maintenance_work_mem = {{ postgres_maintenance_work_mem | default('2GB' if ram_mb >= 49152 else '1GB', true) }}

# The 1GB default checkpoints too often under sustained writes; WAL space is
# cheap next to the data disk.
max_wal_size = {{ postgres_max_wal_size | default('4GB', true) }}

# SSD-backed storage: the 4.0 default assumes spinning disks and steers the
# planner away from index scans it should take.
random_page_cost = {{ postgres_random_page_cost | default('1.1', true) }}
effective_io_concurrency = {{ postgres_effective_io_concurrency | default('200', true) }}

# Compress full-page images: less WAL written, archived, and streamed.
wal_compression = {{ postgres_wal_compression | default('lz4', true) }}

# ── Observability ─────────────────────────────────────────────────────────────
# What turns "the database was slow" into "this statement was slow, this often".
# It costs a fixed hash table allocated at startup plus a few instructions per
# execution — cheap next to the alternative, which is guessing. Preloaded, so
# it needs a restart, and the reading view needs CREATE EXTENSION once: the
# role does that in the maintenance database, and one is enough because the
# counters are cluster-wide and every row carries its dbid.
shared_preload_libraries = '{{ postgres_shared_preload_libraries | default('pg_stat_statements', true) }}'
pg_stat_statements.max = {{ postgres_pg_stat_statements_max | default(5000) }}
pg_stat_statements.track = top

# Slow statements only. 0 logs every statement, including the thousands the
# application already accounts for, and then the log volume is the incident.
log_min_duration_statement = {{ postgres_log_min_duration_statement | default('1000', true) }}

# A wait longer than deadlock_timeout (1s) is contention, and it is the one
# event that cannot be reconstructed afterwards from anything else.
log_lock_waits = on

# A query that spilled to disk is work_mem being too small for that query,
# named. This is what says whether the memory tier needs to move — better
# evidence than the RAM number the tier is derived from.
log_temp_files = {{ postgres_log_temp_files | default('8MB', true) }}

# ── Safety valves ─────────────────────────────────────────────────────────────
# A session that opened a transaction and then stopped working holds its
# connection slot and blocks vacuum from cleaning anything newer than it. This
# kills only sessions idle *inside* a transaction, so a migration that is
# actually executing a long statement is untouched.
idle_in_transaction_session_timeout = {{ postgres_idle_in_transaction_session_timeout | default('5min', true) }}

# Deliberately absent: idle_session_timeout. Closing idle connections behind a
# client-side pool does not free resources, it hands the application dead
# handles — Npgsql's Connection Idle Lifetime is the setting that belongs on
# that side of the wire, and the connection strings set it.
