# TYPE  DATABASE        USER            ADDRESS                 METHOD
local   all             postgres                                peer
local   all             all                                     scram-sha-256
host    all             all             127.0.0.1/32            scram-sha-256
host    all             all             ::1/128                 scram-sha-256
{% if postgres_app_cidr | default('') | length > 0 %}
host    all             all             {{ postgres_app_cidr }}             scram-sha-256
{% endif %}
{% for cidr in postgres_extra_cidrs | default([]) %}
host    all             all             {{ cidr }}             scram-sha-256
{% endfor %}
{% if postgres_wal_archive_enabled | default(false) %}
# The weekly pg_basebackup runs as the postgres OS user over the local socket; "all" above does not
# match replication connections, so it needs its own line.
local   replication     postgres                                peer
{% endif %}
