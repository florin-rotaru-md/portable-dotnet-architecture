{% if alloy_loki_url is defined and (alloy_loki_url | string | trim | length > 0) %}
{%   set loki_push_url = alloy_loki_url | trim %}
{% elif (monitoring_target | default('app')) == 'monitoring' %}
{%   set monitoring_host = hostvars[groups['monitoring'][0]].ansible_host | default(groups['monitoring'][0]) %}
{%   set loki_push_url = 'http://' ~ monitoring_host ~ ':' ~ (loki_port | string) ~ '/loki/api/v1/push' %}
{% else %}
{%   set loki_push_url = 'http://127.0.0.1:' ~ (loki_port | string) ~ '/loki/api/v1/push' %}
{% endif %}
loki.write "default" {
  endpoint {
    url = "{{ loki_push_url }}"
  }
}

{% for app in native_apps %}
{% set app_label = app.name | regex_replace('[^a-zA-Z0-9_]', '_') %}
local.file_match "{{ app_label }}" {
  path_targets = [{
    // Same expression the app role uses to create the directory and to grant the unit write
    // access. It used to read app.name alone, which is only ever equal by luck — the day someone
    // sets log_dir_name, Alloy tails an empty directory and reports nothing wrong.
    __path__ = "{{ alloy_logs_root }}/{{ app.log_dir_name | default(app.name) }}/{{ alloy_log_glob }}",
    job      = "dotnet",
    service  = "{{ app.name }}",
    host     = "{{ inventory_hostname }}",
    // A target label, not a field parsed out of every line: one label on the stream costs nothing
    // per event, where a Serilog property would have cost its bytes on all of them.
    env      = "{{ alloy_env_label | default('production') }}",
  }]
}

loki.source.file "{{ app_label }}" {
  targets    = local.file_match.{{ app_label }}.targets
  forward_to = [loki.process.{{ app_label }}.receiver]
}

loki.process "{{ app_label }}" {
  // The app writes one JSON object per line: @t timestamp, @l level, @m rendered message,
  // @x exception. `env` used to be extracted here too, from a Serilog Properties block that no
  // deployment ever emitted — it is a target label above now, where it costs nothing per line.
  stage.json {
    expressions = {
      ts        = "\"@t\"",
      level     = "\"@l\"",
      msg       = "\"@m\"",
      exception = "\"@x\"",
    }
  }

  stage.timestamp {
    source = "ts"
    format = "RFC3339"
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}

{% endfor %}
