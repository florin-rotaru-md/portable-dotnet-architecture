services:
  loki:
    image: {{ loki_image }}
    container_name: loki
    restart: unless-stopped
    command: ["-config.file=/etc/loki/config.yml"]
    ports:
      - "{{ loki_bind_address | default(monitoring_bind_address) }}:{{ loki_port }}:{{ loki_port }}"
    volumes:
      - ./loki/config.yml:/etc/loki/config.yml:ro
      - ./loki/data:/loki

  grafana:
    image: {{ grafana_image }}
    container_name: grafana
    restart: unless-stopped
    ports:
      - "{{ grafana_bind_address | default(monitoring_bind_address) }}:{{ grafana_port }}:3000"
    environment:
      GF_SECURITY_ADMIN_USER: "{{ grafana_admin_user }}"
      GF_SECURITY_ADMIN_PASSWORD: "{{ grafana_admin_password }}"
    volumes:
      - ./grafana/data:/var/lib/grafana
    depends_on:
      - loki