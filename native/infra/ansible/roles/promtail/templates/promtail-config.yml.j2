{% if promtail_loki_url is defined and (promtail_loki_url | string | trim | length > 0) %}
{%   set loki_push_url = promtail_loki_url | trim %}
{% elif (monitoring_target | default('app')) == 'monitoring' %}
{%   set monitoring_host = hostvars[groups['monitoring'][0]].ansible_host | default(groups['monitoring'][0]) %}
{%   set loki_push_url = 'http://' ~ monitoring_host ~ ':' ~ (loki_port | string) ~ '/loki/api/v1/push' %}
{% else %}
{%   set loki_push_url = 'http://127.0.0.1:' ~ (loki_port | string) ~ '/loki/api/v1/push' %}
{% endif %}

server:
  http_listen_port: {{ promtail_http_port }}
  grpc_listen_port: 0

positions:
  filename: {{ promtail_positions_file }}

clients:
  - url: "{{ loki_push_url }}"

scrape_configs:
{% for app in native_apps %}
  - job_name: "{{ app.name }}"
    static_configs:
      - targets: ["localhost"]
        labels:
          job: dotnet
          service: "{{ app.name }}"
          host: "{{ inventory_hostname }}"
          __path__: "{{ promtail_logs_root }}/{{ app.name }}/{{ promtail_log_glob }}"

{% endfor %}
