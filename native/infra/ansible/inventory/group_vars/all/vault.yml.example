---
# Copy to vault.yml and fill in values.
# Encrypt with: ansible-vault encrypt vault.yml

# Controller public key installed into the service account's authorized_keys
ansible_ssh_public_key: "{{ lookup('file', '~/.ssh/id_ed25519_devops.pub') }}"

# Additional authorized keys — workstation, break-glass kept offline, and every
# key seeded outside Ansible that is still a way in (a hypervisor's root key: on
# the Proxmox build, both nodes' /root/.ssh/id_ed25519.pub).
# See ssh_authorized_keys_exclusive in main.yml for declarative rotation.
# ansible_ssh_extra_public_keys:
#   - "ssh-ed25519 AAAA... workstation"
#   - "ssh-ed25519 AAAA... break-glass"
#   - "ssh-ed25519 AAAA... pve1-root"
#   - "ssh-ed25519 AAAA... pve2-root"

postgres_password: "change-me-strong-password"

# Required only for private Git repositories. Used by the first auto-deploy and
# rendered per app to /opt/apps/<app>/config/repo-token (0600) for later deploys.
# Prefer a fine-grained PAT: only the deployed repos, Contents: Read-only.
# app_repo_token: "ghp_xxx"

# Required only when use_cloudflared: true
# cloudflare_token: "eyJhIjoiABCD..."

# Required only when postgres_wal_stream_enabled: true
# postgres_wal_stream_password: "change-me-strong-password"

# Required only when use_loki_grafana: true
# grafana_admin_password: "change-me-strong-password"
