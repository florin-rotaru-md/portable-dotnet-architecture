---
# ── Ansible service account ────────────────────────────────────────────────────
ansible_user: devops
# ansible_ssh_public_key comes from vault.yml — paste your controller's public key there

# Additional authorized keys (workstation, break-glass kept offline). One key is
# a single point of failure. Public keys — safe in git, or next to
# ansible_ssh_public_key in vault.yml.
# ansible_ssh_extra_public_keys:
#   - "ssh-ed25519 AAAA... workstation"
#   - "ssh-ed25519 AAAA... break-glass"
#   - "ssh-ed25519 AAAA... hypervisor-root"     # see the note below

# The list must also contain every key that was seeded OUTSIDE Ansible and is
# still a way in — a hypervisor's root key, an installer-imported key. Those
# don't feel like "identities", which is exactly why the first exclusive run
# deletes them and takes the get-in-from-the-host path with it. On the Proxmox
# build that means both nodes' /root/.ssh/id_ed25519.pub (proxmox-lab 21.6).

# Once EVERY key you rely on is listed above, flip to true: keys not in the list
# are removed on the next run — rotating a compromised key = one playbook run.
# Check what is actually authorized first:
#   ansible all -m command -a 'cat ~/.ssh/authorized_keys' -b --become-user devops
ssh_authorized_keys_exclusive: false

# The common role pins PasswordAuthentication no in sshd, so a console password
# (Proxmox --cipassword) never opens password auth over SSH.
ssh_disable_password_auth: true

# The common role grows the root partition/LVM/filesystem into whatever disk the
# hypervisor granted (e.g. qm resize) — a no-op when nothing changed. LVM layouts
# only (ISO-installed guests): cloud-image guests have root on a plain partition
# that cloud-init grows at every boot — set false there (proxmox-lab Stage 11).
grow_root_filesystem: true

# ── Apps (required) ───────────────────────────────────────────────────────────
app_user: devops
app_log_root: /var/log
health_max_attempts: 16
health_interval_seconds: 4
# Global defaults used for all apps unless overridden per-app in applications[].

applications:
  - name:         myapp
    # log_dir_name: myapp
    assembly:     MyApp
    domain:       demo.example.com
    port_blue:    5000
    port_green:   5001
    # Optional per-app override:
    # health_max_attempts: 16
    # health_interval_seconds: 4
    drain_seconds: 30
    repo_url:     ""
    repo_branch:  "master"
    project_path: ""
    # Set when this app renders through a headless browser (needs use_headless_browser: true):
    # headless_browser: true
    # repo_token: "{{ app_repo_token }}"
    # Npgsql keeps one pool per unique connection string; cap each with
    # Maximum Pool Size. postgres_max_connections above carries the
    # arithmetic that turns these caps into a server ceiling — the sum over
    # every deployment, plus the largest single one again for the length of
    # a drain, not this total doubled.
    # The pool is a ceiling, not a target: Npgsql opens connections on
    # demand, and past what the database can execute at once a larger pool
    # only moves the queue from the application into Postgres. Keepalive=60
    # lets the pool detect and evict connections killed by a Postgres restart
    # (auto minor upgrades, HA failover) before requests trip over them.
    # Timeout=5 fails a request that cannot get a connection rather than
    # pinning a Kestrel thread for the default 15s; Command Timeout=30 bounds
    # one bad query; Connection Idle Lifetime=60 hands slots back four minutes
    # sooner than the default, which is what keeps the drain window's worst
    # case theoretical.
    # appsettings_override:
    #   ConnectionStrings:
    #     Main: "Host={{ postgres_host }};Port=5432;Database=myapp_db;Username={{ postgres_user }};Password={{ postgres_password }};Pooling=true;Keepalive=60;Maximum Pool Size=64;Timeout=5;Command Timeout=30;Connection Idle Lifetime=60"
    # env:
    #   SomeSetting__Nested__Value: "example"

apps_root:  /opt/apps
dotnet_version: "10.0"

# ── Headless browser (optional) ───────────────────────────────────────────────
# Install Chrome on the app host for server-side HTML → PNG/PDF rendering (PuppeteerSharp,
# Playwright). Adds ~400 MB. Apps that use it also want `headless_browser: true` in their
# applications[] entry, which gives the service a writable HOME for the browser profile.
use_headless_browser: true

# ── Postgres ───────────────────────────────────────────────────────────────────
postgres_version: "18"
postgis_major_version: "3"
postgres_user:    myapp
backup_retention_days: 7
# postgres_password comes from vault.yml

# Automatic MINOR upgrades (e.g. 18.1 -> 18.2, the quarterly security fixes):
# the role installs with state: latest AND configures unattended-upgrades with
# the PGDG origin, so minors land within ~24h without a playbook run. A MAJOR
# can never arrive automatically — the package name embeds the major version,
# so a new major always requires a deliberate postgres_version bump.
# The minor install restarts the cluster briefly (~06:00, apt-daily-upgrade.timer).
postgres_auto_minor_upgrades: true

# ── Postgres tuning (conf.d/10-tuning.conf) ───────────────────────────────────
# max_connections is policy, not RAM: it follows the Maximum Pool Size caps in
# the connection strings, and the window that sizes it is a deploy, not rush
# hour. Add up what every application holds at rest, then add the largest
# single one back for the length of a drain (both of that app's slots hold
# their own pools), plus headroom for psql/monitoring/backup:
#
#   82 + 82 + 18 = 182 steady, + 82 for the largest single drain = 264,
#   inside 400 - 3 reserved = 397.
#
# Deploys taken one at a time are what make 264 the worst case, and that stays
# an honour system: the deploy playbook serialises them, not the database.
# Per-application roles with a CONNECTION LIMIT are what would enforce it, and
# there are none here — every application connects as the postgres superuser
# and owns its own databases, which is one restore story bought at the price of
# one application being able to starve the others.
# A RAM upgrade does not move it; another application does. perf/load-drill.sh
# recomputes this from scenarios/endpoints.json and fails the run when it stops
# fitting.
postgres_max_connections: 400

# Slots held back for superusers — Postgres' own default, rendered explicitly
# so the number every budget above subtracts is asserted rather than inherited.
# It reserves nothing from an application that connects as a superuser, which
# is every application here; subtracting it keeps the budget conservative.
# postgres_superuser_reserved_connections: 3

# Everything else derives from the host's RAM on every playbook run
# (shared_buffers 25%, effective_cache_size 75%, work_mem and
# maintenance_work_mem step up at 48GB) — growing the VM and re-running
# bootstrap is the whole tuning upgrade. Override only when the derived value
# is wrong for the workload:
# postgres_shared_buffers:           "8GB"
# postgres_effective_cache_size:     "24GB"
# postgres_work_mem:                 "32MB"
# postgres_maintenance_work_mem:     "1GB"
# postgres_max_wal_size:             "4GB"
# postgres_random_page_cost:         "1.1"
# postgres_effective_io_concurrency: "200"
# postgres_wal_compression:          "lz4"

# Nightly logical dump schedule (cron on the postgres host).
# Ordering contract: in-VM dump BEFORE the VM-image backup, which runs BEFORE
# any offsite sync — so every image/offsite copy contains a fresh dump.
postgres_backup_hour:   "2"
postgres_backup_minute: "15"

# postgres_host: IP or hostname that the app VM uses to reach PostgreSQL.
#   - Single-VM deploy (app + postgres on same host): keep 127.0.0.1
#   - Split-VM deploy (dedicated postgres VM):        set to the postgres VM IP
postgres_host: "127.0.0.1"

# postgres_app_cidr: CIDR allowed to connect to PostgreSQL over TCP.
#   - Single-VM deploy: leave empty (loopback-only access)
#   - Split-VM deploy:  set to the subnet that contains the app VM
#     e.g. "10.0.0.0/24" for a VPS private network, "192.168.0.0/24" for LAN
postgres_app_cidr: ""

# postgres_extra_cidrs: additional CIDRs allowed to connect, beyond
# postgres_app_cidr — e.g. your workstation (psql/pgAdmin/DBeaver) or the
# whole home LAN. Each entry gets a pg_hba.conf line and a UFW allow for
# 5432/tcp; authentication still requires the postgres_user password.
#   postgres_extra_cidrs: ["192.168.0.50/32"]   # a single workstation
#   postgres_extra_cidrs: ["192.168.0.0/24"]    # the whole LAN
# Removing an entry closes pg_hba.conf on the next run, but the UFW rule
# must be deleted by hand (ufw status numbered && ufw delete <n>).
postgres_extra_cidrs: []

# ── WAL streaming to a third box (optional) ────────────────────────────────────
# Streams the write-ahead log to an always-on receiver (pg_receivewal), so an
# unplanned failover loses seconds instead of the VM-replication interval.
# Receiver setup + the recovery procedure: proxmox-lab/ha/13-wal-stream.md
postgres_wal_stream_enabled: false
postgres_wal_stream_user: "walreceiver"
postgres_wal_stream_slot: "wal_archive"
# The receiver's address as a CIDR, e.g. "192.168.0.10/32" (the QDevice)
postgres_wal_stream_cidr: ""
# Safety valve: max WAL retained for a disconnected receiver, so a dead
# receiver breaks the stream instead of filling the database disk.
postgres_max_slot_wal_keep_size: "10GB"
# postgres_wal_stream_password comes from vault.yml when enabled

# ── Cloudflare (optional) ──────────────────────────────────────────────────────
use_cloudflared: false
# cloudflare_token comes from vault.yml when use_cloudflared: true

# Connector version. Pinned deliberately: the service runs with --no-autoupdate and
# unattended-upgrades covers only the PGDG origin, so nothing here moves on its own —
# which is what you want from the only public ingress. Upgrading is a bump here, then
# `bootstrap.yml --limit app --tags cloudflared`; rolling back is the same bump in
# reverse (the role allows a downgrade). `apt-cache madison cloudflared` on the app
# host lists what the repository currently has. Left unset you get whatever was
# current on install day, and it stays there for ever.
# cloudflared_version: "2026.8.2"

# ── Loki + Grafana (optional, Docker) ─────────────────────────────────────────
use_loki_grafana: false
# Where to run Loki/Grafana:
#   app        = install on the app host (default, single-VM style)
#   monitoring = install on hosts in [monitoring] group (dedicated VM)
monitoring_target: app
monitoring_root: /opt/monitoring
monitoring_bind_address: "127.0.0.1"
loki_bind_address: "127.0.0.1"
grafana_bind_address: "127.0.0.1"
# monitoring_allowed_cidr: ""   # CIDR allowed to reach Grafana through UFW (e.g. 192.168.0.0/24)
loki_image: "grafana/loki:3.0.0"
grafana_image: "grafana/grafana:11.1.4"
grafana_port: 3000
loki_port: 3100
grafana_admin_user: admin
# grafana_admin_password comes from vault.yml when use_loki_grafana: true
grafana_loki_datasource_name: "Loki"
grafana_loki_datasource_url: "http://loki:3100"
grafana_loki_is_default: true
# How long Loki keeps a stream. Enforced by the compactor, which the config enables alongside it —
# left unset, Loki's own default is to keep everything for ever on a disk that only grows.
loki_retention_period: "720h"

# ── Grafana Alloy (optional, runs on app host) ────────────────────────────────
alloy_http_port: 12345
alloy_logs_root: "{{ app_log_root }}"
alloy_log_glob: "*.log"
# Static label on every stream this host ships. One label per stream, not a field per line.
alloy_env_label: "production"
# alloy_loki_url can override automatic endpoint discovery, for example:
# alloy_loki_url: "http://192.168.0.23:3100/loki/api/v1/push"

# ── Firewall ───────────────────────────────────────────────────────────────────
ufw_allowed_tcp_ports:
  - "22"
  - "80"
  - "443"
