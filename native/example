on local pc
---
ssh-keygen -R 192.168.0.21

on target vm:
---
> /home/deploy/.ssh/authorized_keys

echo 'deploy ALL=(ALL) NOPASSWD: ALL' | sudo tee /etc/sudoers.d/deploy
sudo chmod 440 /etc/sudoers.d/deploy

on control vm:
---
sudo apt update && \
sudo apt upgrade -y && \
sudo apt install -y git curl python3 python3-pip python3-venv pipx openssh-client && \
mkdir -p ~/.local/bin && \
echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.bashrc && \
export PATH="$HOME/.local/bin:$PATH" && \
pipx ensurepath && \
pipx install --include-deps ansible

test -f ~/.ssh/id_ed25519_ansible || \
  ssh-keygen -t ed25519 -C "ansible-control" -f ~/.ssh/id_ed25519_ansible -N ""

chmod 700 /home/deploy/.ssh && \
chmod 600 /home/deploy/.ssh/authorized_keys && \
chown -R deploy:deploy /home/deploy/.ssh

ssh-copy-id -i ~/.ssh/id_ed25519_ansible.pub deploy@192.168.0.21

mkdir -p ~/src && cd ~/src && \
git clone https://github.com/florin-rotaru-md/portable-dotnet-architecture


cat << 'EOF' > ~/src/portable-dotnet-architecture/native/infra/ansible/inventory/group_vars/all/vault.yml
ansible_ssh_public_key:  "{{ lookup('file', '~/.ssh/id_ed25519_ansible.pub') }}"

postgres_password: "postgres"

# Required for private repos used in first auto-deploy.
app_repo_token: "ghp_real_token_here"

# Required only when use_cloudflared: true
# cloudflare_token: "eyJhIjoiABCD..."
EOF


cat << 'EOF' > ~/src/portable-dotnet-architecture/native/infra/ansible/inventory/group_vars/all/main.yml
---
# ── Ansible service account ────────────────────────────────────────────────────
ansible_user: deploy

# ── Infrastructure ─────────────────────────────────────────────────────────────
app_user:     deploy
apps_root:    /opt/apps
dotnet_version: "10.0"

# ── Postgres ───────────────────────────────────────────────────────────────────
postgres_version: "18"
postgres_user:    postgres
backup_retention_days: 7

# ── Cloudflare (optional) ──────────────────────────────────────────────────────
use_cloudflared: false

# ── Firewall ───────────────────────────────────────────────────────────────────
ufw_allowed_tcp_ports:
  - "22"
  - "80"
  - "443"

# ── Native multi-app mode (recommended) ───────────────────────────────────────
health_max_attempts: 16
health_interval_seconds: 4

applications:
  - name:          api.waa.ro
    assembly:      Waa.Server
    domain:        api.waa.ro
    port_blue:     5000
    port_green:    5001
    # Optional per-app override:
    # health_max_attempts: 16
    # health_interval_seconds: 4
    drain_seconds: 30
    repo_url:      "https://github.com/florin-rotaru-md/Statics.git"
    repo_branch:   "master"
    project_path:  "Apps/Waa/Waa.Server/Waa.Server.csproj"
    repo_token:    "{{ app_repo_token }}"
    # ── appsettings.Production.json override ────────────────────────────────
    # This dict is rendered as appsettings.Production.json and mounted
    # read-only into the container.  .NET merges it on top of the
    # appsettings.json baked into the image (DOTNET_ENVIRONMENT=Production).
    # Put connection strings, secrets, and env-specific URLs here.
    # Secrets (passwords, API keys) should reference vault.yml variables.
    appsettings_override:
      ConnectionStrings:
        App:            "Host=127.0.0.1;Port=5432;Database=waa_ro_app;Username={{ postgres_user }};Password={{ postgres_password }};Pooling=true"
        Users:          "Host=127.0.0.1;Port=5432;Database=waa_ro_users;Username={{ postgres_user }};Password={{ postgres_password }};Pooling=true"
        DataProtection: "Host=127.0.0.1;Port=5432;Database=waa_ro_dp;Username={{ postgres_user }};Password={{ postgres_password }};Pooling=true"
      # FileStorage:
      #   BaseDirectory: "/data/files"
      # UiClient:
      #   Urls:
      #     SignInWithToken: "https://www.example.com/auth/sign-in"
    env:
      ASPNETCORE_FORWARDEDHEADERS_ENABLED: "true"

#   - name:          admin.waa.ro
#     assembly:      Waa.Admin
#     domain:        admin.waa.ro
#     port_blue:     5010
#     port_green:    5011
#     drain_seconds: 30
#     repo_url:      "https://github.com/florin-rotaru-md/waa-server.git"
#     repo_branch:   "master"
#     project_path:  "src/Waa.Admin/Waa.Admin.csproj"
#     repo_token:    "{{ app_repo_token }}"
#     appsettings_override:
#       ConnectionStrings:
#         Main: "Host=127.0.0.1;Port=5432;Database=waa_ro_admin;Username={{ postgres_user }};Password={{ postgres_password }};Pooling=true"
EOF


cat << 'EOF' > ~/src/portable-dotnet-architecture/native/infra/ansible/inventory/hosts.ini
[app]
192.168.0.21 ansible_user=deploy ansible_private_key_file=~/.ssh/id_ed25519_ansible

# Example with SSH key:
# 1.2.3.4 ansible_user=deploy ansible_private_key_file=~/.ssh/id_ed25519_ansible
EOF


# First bootstrap on a fresh VM can be done as root if deploy is missing:
cd ~/src/portable-dotnet-architecture/native/infra/ansible && \
ansible-playbook playbooks/bootstrap.yml -u root --ask-vault-pass

# Normal path (deploy user exists and key auth works):
cd ~/src/portable-dotnet-architecture/native/infra/ansible && \
ansible-playbook playbooks/bootstrap.yml

# If vault.yml is encrypted:
# ansible-playbook playbooks/bootstrap.yml --ask-vault-pass

# Bootstrap performs first deploy automatically for every app that has repo_url + project_path.
# Manual deploy examples:
# sudo -u deploy /opt/apps/api.waa.ro/scripts/deploy.sh
# sudo -u deploy /opt/apps/admin.waa.ro/scripts/deploy.sh

# Manual rollback examples:
# sudo -u deploy /opt/apps/api.waa.ro/scripts/rollback.sh
# sudo -u deploy /opt/apps/admin.waa.ro/scripts/rollback.sh
