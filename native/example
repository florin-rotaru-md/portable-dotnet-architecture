on local pc
---
ssh-keygen -R 192.168.0.21

on target vm:
---
> /home/devops/.ssh/authorized_keys

echo 'devops ALL=(ALL) NOPASSWD: ALL' | sudo tee /etc/sudoers.d/devops
sudo chmod 440 /etc/sudoers.d/devops

lsblk
NAME                      MAJ:MIN RM SIZE RO TYPE MOUNTPOINTS
sda                         8:0    0  32G  0 disk
├─sda1                      8:1    0   1M  0 part
├─sda2                      8:2    0   2G  0 part /boot
└─sda3                      8:3    0  30G  0 part
  └─ubuntu--vg-ubuntu--lv 252:0    0  15G  0 lvm  /
sr0                        11:0    1   4M  0 rom

# A root LV smaller than the disk (like the 15G-of-30G above) needs no manual
# fixing: the common role grows partition/PV/LV/filesystem on every playbook
# run (grow_root_filesystem in main.yml).

on control vm:
---
sudo apt update && \
sudo apt upgrade -y && \
sudo apt install -y git curl python3 python3-pip python3-venv pipx openssh-client && \
mkdir -p ~/.local/bin && \
echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.bashrc && \
export PATH="$HOME/.local/bin:$PATH" && \
pipx ensurepath && \
pipx install --include-deps ansible

# SSH key — generate once, reuse across rebuilds / disaster recovery
# Option A: Linux / WSL / macOS
test -f ~/.ssh/id_ed25519_devops || \
  ssh-keygen -t ed25519 -C "devops" -f ~/.ssh/id_ed25519_devops -N ""

# Option B: Windows (PowerShell — OpenSSH built-in, Windows 10 1809+)
# if (-not (Test-Path "$env:USERPROFILE\.ssh\id_ed25519_devops")) {
#   ssh-keygen -t ed25519 -C "devops" -f "$env:USERPROFILE/.ssh/id_ed25519_devops" -N '""'
# }

# Backup — run once after generation; store securely (password manager, encrypted USB, vault):
# cp ~/.ssh/id_ed25519_devops     ~/id_ed25519_devops.bak
# cp ~/.ssh/id_ed25519_devops.pub ~/id_ed25519_devops.pub.bak

# Restore on a new / recovered control VM (avoids re-running ssh-copy-id on all targets):
# mkdir -p ~/.ssh && chmod 700 ~/.ssh
# cp id_ed25519_devops     ~/.ssh/id_ed25519_devops
# cp id_ed25519_devops.pub ~/.ssh/id_ed25519_devops.pub
# chmod 600 ~/.ssh/id_ed25519_devops
# chmod 644 ~/.ssh/id_ed25519_devops.pub

chmod 700 /home/devops/.ssh && \
chmod 600 /home/devops/.ssh/authorized_keys && \
chown -R devops:devops /home/devops/.ssh

ssh-copy-id -i ~/.ssh/id_ed25519_devops.pub devops@192.168.0.21

mkdir -p ~/src && cd ~/src && \
git clone https://github.com/florin-rotaru-md/portable-dotnet-architecture


cat << 'EOF' > ~/src/portable-dotnet-architecture/native/infra/ansible/inventory/group_vars/all/vault.yml
ansible_ssh_public_key:  "{{ lookup('file', '~/.ssh/id_ed25519_devops.pub') }}"

# Additional authorized keys — workstation, break-glass kept offline, and every
# key seeded outside Ansible that is still a way in (on the Proxmox build: both
# nodes' /root/.ssh/id_ed25519.pub).
# ansible_ssh_extra_public_keys:
#   - "ssh-ed25519 AAAA... workstation"
#   - "ssh-ed25519 AAAA... break-glass"
#   - "ssh-ed25519 AAAA... pve1-root"
#   - "ssh-ed25519 AAAA... pve2-root"

postgres_password: "postgres"

# Required for private repos. Used by the first auto-deploy, and rendered per app
# to /opt/apps/<app>/config/repo-token (0600) so later deploys don't retype it.
# Prefer a fine-grained PAT: only the deployed repos, Contents: Read-only.
app_repo_token: "ghp_real_token_here"

# Required only when use_cloudflared: true
# cloudflare_token: "eyJhIjoiABCD..."

# Required only when postgres_wal_stream_enabled: true
# postgres_wal_stream_password: "change-me-strong-password"
EOF


cat << 'EOF' > ~/src/portable-dotnet-architecture/native/infra/ansible/inventory/group_vars/all/main.yml
---
# ── Ansible service account ────────────────────────────────────────────────────
ansible_user: devops
# ansible_ssh_public_key (+ optional ansible_ssh_extra_public_keys) come from vault.yml

# Once EVERY key you rely on is listed in vault.yml, flip to true: keys not in
# the list are removed on the next run — key rotation = one playbook run.
# Include the keys seeded outside Ansible (hypervisor root, installer-imported)
# or the first run deletes them; check first with:
#   ansible all -m command -a 'cat ~/.ssh/authorized_keys' -b --become-user devops
ssh_authorized_keys_exclusive: false

# Grow the root partition/LVM/filesystem into whatever the hypervisor granted —
# a no-op when nothing changed, so it runs on every host, every run. LVM layouts
# only: cloud-image guests grow themselves via cloud-init — set false there
# (proxmox-lab Stage 11).
grow_root_filesystem: true

# ── Infrastructure ─────────────────────────────────────────────────────────────
app_user: devops
apps_root:    /opt/apps
dotnet_version: "10.0"

# ── Postgres ───────────────────────────────────────────────────────────────────
postgres_version: "18"
postgis_major_version: "3"
postgres_user:    postgres
backup_retention_days: 7

# Minor releases (18.1 -> 18.2) install automatically via unattended-upgrades
# with the PGDG origin; majors always require a deliberate postgres_version bump.
postgres_auto_minor_upgrades: true

# ── Postgres tuning (conf.d/10-tuning.conf) ───────────────────────────────────
# max_connections is policy, not RAM: sized from the per-app Npgsql pool budget
# (Maximum Pool Size caps in the connection strings, ~18-28 per app, ~4 apps)
# plus headroom for psql/monitoring/backup. A RAM upgrade does not move it.
postgres_max_connections: 128

# Everything else derives from the host's RAM on every playbook run
# (shared_buffers 25%, effective_cache_size 75%, work_mem and
# maintenance_work_mem step up at 48GB) — growing the VM and re-running
# bootstrap is the whole tuning upgrade. Override only when the derived value
# is wrong for the workload:
# postgres_shared_buffers:           "8GB"
# postgres_effective_cache_size:     "24GB"
# postgres_work_mem:                 "32MB"
# postgres_maintenance_work_mem:     "1GB"
# postgres_max_wal_size:             "4GB"
# postgres_random_page_cost:         "1.1"
# postgres_effective_io_concurrency: "200"
# postgres_wal_compression:          "lz4"

# Nightly logical dump schedule — keep it BEFORE any VM-image backup.
postgres_backup_hour:   "2"
postgres_backup_minute: "15"

# postgres_host: IP or hostname that the app VM uses to reach PostgreSQL.
#   - Single-VM deploy (app + postgres on same host): keep 127.0.0.1
#   - Split-VM deploy (dedicated postgres VM):        set to the postgres VM IP
postgres_host: "127.0.0.1"

# postgres_app_cidr: CIDR allowed to connect to PostgreSQL over TCP.
#   - Single-VM deploy: leave empty (loopback-only access)
#   - Split-VM deploy:  set to the subnet that contains the app VM
#     e.g. "10.0.0.0/24" for a VPS private network, "192.168.0.0/24" for LAN
postgres_app_cidr: ""

# postgres_extra_cidrs: additional CIDRs allowed to connect, beyond
# postgres_app_cidr — e.g. your workstation (psql/pgAdmin/DBeaver) or the
# whole home LAN. Each entry gets a pg_hba.conf line and a UFW allow for
# 5432/tcp; authentication still requires the postgres_user password.
#   postgres_extra_cidrs: ["192.168.0.50/32"]   # a single workstation
#   postgres_extra_cidrs: ["192.168.0.0/24"]    # the whole LAN
# Removing an entry closes pg_hba.conf on the next run, but the UFW rule
# must be deleted by hand (ufw status numbered && ufw delete <n>).
postgres_extra_cidrs: []

# ── WAL streaming to a third box (optional) ────────────────────────────────────
# Streams the write-ahead log to an always-on receiver (pg_receivewal), so an
# unplanned failover loses seconds instead of the VM-replication interval.
# Receiver setup + the recovery procedure: proxmox-lab/ha/13-wal-stream.md
postgres_wal_stream_enabled: false
postgres_wal_stream_user: "walreceiver"
postgres_wal_stream_slot: "wal_archive"
# The receiver's address as a CIDR, e.g. "192.168.0.13/32" (the QDevice)
postgres_wal_stream_cidr: ""
# Safety valve: max WAL retained for a disconnected receiver, so a dead
# receiver breaks the stream instead of filling the database disk.
postgres_max_slot_wal_keep_size: "10GB"
# postgres_wal_stream_password comes from vault.yml when enabled

# ── Cloudflare (optional) ──────────────────────────────────────────────────────
use_cloudflared: false

# ── Firewall ───────────────────────────────────────────────────────────────────
ufw_allowed_tcp_ports:
  - "22"
  - "80"
  - "443"

# ── Native multi-app mode (recommended) ───────────────────────────────────────
health_max_attempts: 16
health_interval_seconds: 4

applications:
  - name:          api.waa.ro
    assembly:      Waa.Server
    domain:        api.waa.ro
    port_blue:     5000
    port_green:    5001
    # Optional per-app override:
    # health_max_attempts: 16
    # health_interval_seconds: 4
    drain_seconds: 32
    repo_url:      "https://github.com/florin-rotaru-md/statics.git"
    repo_branch:   "master"
    project_path:  "Apps/Waa/Waa.Server/Waa.Server.csproj"
    repo_token:    "{{ app_repo_token }}"
    # ── appsettings.override.json override ────────────────────────────────
    # This dict is rendered as appsettings.override.json and mounted
    # read-only into the container.  .NET merges it on top of the
    # appsettings.json baked into the image (DOTNET_ENVIRONMENT=Production).
    # Put connection strings, secrets, and env-specific URLs here.
    # Secrets (passwords, API keys) should reference vault.yml variables.
    # Npgsql keeps one pool per unique connection string; Maximum Pool Size
    # caps each pool. Per-app budget: 18+8+2 = 28 connections worst case, so
    # ~4 apps sharing one Postgres stay inside max_connections = 128.
    # Keepalive=60 lets the pool detect and evict connections killed by a
    # Postgres restart (auto minor upgrades, HA failover) before requests
    # trip over them.
    appsettings_override:
      ConnectionStrings:
        App:            "Host={{ postgres_host }};Port=5432;Database=waa_ro_app;Username={{ postgres_user }};Password={{ postgres_password }};Pooling=true;Keepalive=60;Maximum Pool Size=18"
        Users:          "Host={{ postgres_host }};Port=5432;Database=waa_ro_users;Username={{ postgres_user }};Password={{ postgres_password }};Pooling=true;Keepalive=60;Maximum Pool Size=8"
        DataProtection: "Host={{ postgres_host }};Port=5432;Database=waa_ro_dp;Username={{ postgres_user }};Password={{ postgres_password }};Pooling=true;Keepalive=60;Maximum Pool Size=2"
      # FileStorage:
      #   BaseDirectory: "/data/files"
      # UiClient:
      #   BaseUrl: "https://example.com"
    env:
      ASPNETCORE_FORWARDEDHEADERS_ENABLED: "true"
      # Deployment identity: selects appsettings.{APP_PROFILE}.json from the repo — the one
      # file that names hosts, language, market. Deploy-time env var, deliberately NOT a
      # build-time flavor: one published artifact can run as any deployment, and the app
      # fails at boot if the profile is missing rather than inheriting another's identity.
      # The override block above stays for secrets and machine-local values only.
      # APP_PROFILE: "example.com"

#   - name:          admin.waa.ro
#     assembly:      Waa.Admin
#     domain:        admin.waa.ro
#     port_blue:     5010
#     port_green:    5011
#     drain_seconds: 30
#     repo_url:      "https://github.com/florin-rotaru-md/waa-server.git"
#     repo_branch:   "master"
#     project_path:  "src/Waa.Admin/Waa.Admin.csproj"
#     repo_token:    "{{ app_repo_token }}"
#     appsettings_override:
#       ConnectionStrings:
#         Main: "Host={{ postgres_host }};Port=5432;Database=waa_ro_admin;Username={{ postgres_user }};Password={{ postgres_password }};Pooling=true;Keepalive=60;Maximum Pool Size=5"
EOF


