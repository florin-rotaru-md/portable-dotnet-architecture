on local pc
---
# ── Generate SSH key (run once; reuse across all VMs) ──────────────────────────
# Windows (PowerShell — OpenSSH built-in, Windows 10 1809+)
if (-not (Test-Path "$env:USERPROFILE\.ssh\id_ed25519_devops")) {
  ssh-keygen -t ed25519 -C "devops" -f "$env:USERPROFILE/.ssh/id_ed25519_devops" -N '""'
}
# Print public key — copy this value; you'll need it during VM creation
Get-Content "$env:USERPROFILE\.ssh\id_ed25519_devops.pub"

# Linux / WSL / macOS
# test -f ~/.ssh/id_ed25519_devops || \
#   ssh-keygen -t ed25519 -C "devops" -f ~/.ssh/id_ed25519_devops -N ""
# cat ~/.ssh/id_ed25519_devops.pub

# ── Import the key when creating the VM ───────────────────────────────────────
# Ubuntu Server installer (subiquity):
#   During "SSH Setup" step → enable "Install OpenSSH server"
#   → "Import SSH identity" → choose "No" for GitHub import
#   → paste the public key printed above into "Authorised keys"
#
# Alternatively, after VM creation, on the target VM run:
#   mkdir -p /home/devops/.ssh && chmod 700 /home/devops/.ssh
#   echo 'ssh-ed25519 AAAA... ansible-control' >> /home/devops/.ssh/authorized_keys
#   chmod 600 /home/devops/.ssh/authorized_keys
#   chown -R devops:devops /home/devops/.ssh
#
# Verify connectivity before running Ansible:
#   ssh -i ~/.ssh/id_ed25519_devops devops@192.168.0.22

ssh-keygen -R 192.168.0.22

on target vm:
---
> /home/devops/.ssh/authorized_keys

echo 'devops ALL=(ALL) NOPASSWD: ALL' | sudo tee /etc/sudoers.d/devops
sudo chmod 440 /etc/sudoers.d/devops

lsblk
NAME                      MAJ:MIN RM SIZE RO TYPE MOUNTPOINTS
sda                         8:0    0  32G  0 disk
├─sda1                      8:1    0   1M  0 part
├─sda2                      8:2    0   2G  0 part /boot
└─sda3                      8:3    0  30G  0 part
  └─ubuntu--vg-ubuntu--lv 252:0    0  15G  0 lvm  /
sr0                        11:0    1   4M  0 rom

# A root LV smaller than the disk (like the 15G-of-30G above) needs no manual
# fixing: the common role grows partition/PV/LV/filesystem on every playbook
# run (grow_root_filesystem in main.yml).

on control vm:
---
sudo apt update && \
sudo apt upgrade -y && \
sudo apt install -y git curl python3 python3-pip python3-venv pipx openssh-client && \
mkdir -p ~/.local/bin && \
echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.bashrc && \
export PATH="$HOME/.local/bin:$PATH" && \
pipx ensurepath && \
pipx install --include-deps ansible && \
~/.local/bin/ansible-galaxy collection install community.docker

# SSH key — generate once, reuse across rebuilds / disaster recovery
# Option A: Linux / WSL / macOS
test -f ~/.ssh/id_ed25519_devops || \
  ssh-keygen -t ed25519 -C "devops" -f ~/.ssh/id_ed25519_devops -N ""

# Option B: Windows (PowerShell — OpenSSH built-in, Windows 10 1809+)
# if (-not (Test-Path "$env:USERPROFILE\.ssh\id_ed25519_devops")) {
#   ssh-keygen -t ed25519 -C "devops" -f "$env:USERPROFILE/.ssh/id_ed25519_devops" -N '""'
# }

# Backup — run once after generation; store securely (password manager, encrypted USB, vault):
# cp ~/.ssh/id_ed25519_devops     ~/id_ed25519_devops.bak
# cp ~/.ssh/id_ed25519_devops.pub ~/id_ed25519_devops.pub.bak

# Restore on a new / recovered control VM (avoids re-running ssh-copy-id on all targets):
# mkdir -p ~/.ssh && chmod 700 ~/.ssh
# cp id_ed25519_devops     ~/.ssh/id_ed25519_devops
# cp id_ed25519_devops.pub ~/.ssh/id_ed25519_devops.pub
# chmod 600 ~/.ssh/id_ed25519_devops
# chmod 644 ~/.ssh/id_ed25519_devops.pub

chmod 700 /home/devops/.ssh && \
chmod 600 /home/devops/.ssh/authorized_keys && \
chown -R devops:devops /home/devops/.ssh

ssh-copy-id -i ~/.ssh/id_ed25519_devops.pub devops@192.168.0.22

mkdir -p ~/src && cd ~/src && \
git clone https://github.com/florin-rotaru-md/portable-dotnet-architecture


cat << 'EOF' > ~/app-inventory/group_vars/all/vault.yml
ansible_ssh_public_key:  "{{ lookup('file', '~/.ssh/id_ed25519_devops.pub') }}"

# Additional authorized keys — workstation, break-glass kept offline, and every
# key seeded outside Ansible that is still a way in (hypervisor root key, a key
# the OS installer imported).
# ansible_ssh_extra_public_keys:
#   - "ssh-ed25519 AAAA... workstation"
#   - "ssh-ed25519 AAAA... break-glass"

postgres_root_password:  "postgres"    # POSTGRES_PASSWORD for the postgres container
postgres_password:       "postgres"    # password for postgres_user

# Required only for private GHCR images.
# ghcr_token:            "github_pat_..."
ghcr_token:              "ghp_..."

# Required only when use_cloudflared: true
# cloudflare_token: "eyJhIjoiABCD..."

EOF


cat << 'EOF' > ~/app-inventory/group_vars/all/main.yml
---
# ── Infrastructure ─────────────────────────────────────────────────────────────
app_user: devops
apps_root:        /opt/apps
app_network_name: app_net
health_max_attempts: 16
health_interval_seconds: 4

# ── Postgres (runs as a Docker container on the same host) ─────────────────────
# Minors: the tag pins major.postgis; every playbook run re-pulls the latest
# 18.x patch (pull: always). Majors are deliberate: new tag + dump/restore.
postgres_image:     "postgis/postgis:18-3.6"
postgres_host:      postgres          # Docker service name / internal DNS
postgres_user:      postgres
# postgres_password and postgres_root_password come from vault.yml
backup_retention_days: 7

# ── Postgres tuning (compose command -c flags) ────────────────────────────────
# max_connections is policy, not RAM: sized from the per-app Npgsql pool budget
# (Maximum Pool Size caps in the connection strings, ~18-28 per app, ~4 apps)
# plus headroom for psql/monitoring/backup. A RAM upgrade does not move it.
postgres_max_connections: 128

# Everything else derives from the docker host's RAM on every playbook run
# (shared_buffers 25%, effective_cache_size 75%, work_mem and
# maintenance_work_mem step up at 48GB). Postgres shares this host with the
# app containers, so override when the derived sizes crowd them:
# postgres_shared_buffers:           "2GB"
# postgres_effective_cache_size:     "6GB"
# postgres_work_mem:                 "32MB"
# postgres_maintenance_work_mem:     "1GB"
# postgres_max_wal_size:             "4GB"
# postgres_random_page_cost:         "1.1"
# postgres_effective_io_concurrency: "200"
# postgres_wal_compression:          "lz4"

# Nightly dump schedule (cron on the host).
postgres_backup_hour:   "2"
postgres_backup_minute: "30"

# ── Cloudflare (optional) ──────────────────────────────────────────────────────
use_cloudflared: false
# cloudflare_token comes from vault.yml when use_cloudflared: true

# ── Ansible service account ────────────────────────────────────────────────────
ansible_user: devops
# ansible_ssh_public_key (+ optional ansible_ssh_extra_public_keys) come from vault.yml

# Once EVERY key you rely on is listed in vault.yml, flip to true: keys not in
# the list are removed on the next run — key rotation = one playbook run.
# Include the keys seeded outside Ansible (hypervisor root, installer-imported)
# or the first run deletes them; check first with:
#   ansible all -m command -a 'cat ~/.ssh/authorized_keys' -b --become-user devops
ssh_authorized_keys_exclusive: false

# Grow the root partition/LVM/filesystem into whatever the hypervisor granted —
# a no-op when nothing changed, so it runs on every host, every run. LVM layouts
# only: cloud-image guests grow themselves via cloud-init — set false there
# (proxmox-lab Stage 11).
grow_root_filesystem: true

# ── Firewall ───────────────────────────────────────────────────────────────────
ufw_allowed_tcp_ports:
  - "22"
  - "80"
  - "443"

# ── Applications ───────────────────────────────────────────────────────────────
# Add one entry per application.
# For public GHCR images, image_default is enough.
# For private images, also set registry_server / registry_username here
# and put registry_password in vault.yml (for example: "{{ ghcr_token }}").
applications:
  - name:          api.waa.ro
    server_name:   api.waa.ro
    blue_port:     18081
    green_port:    18082
    internal_port: 8080
    image_default: ghcr.io/florin-rotaru-md/waa-server:latest
    # Optional per-app override:
    # health_max_attempts: 16
    # health_interval_seconds: 4
    registry_server: ghcr.io
    registry_username: florin-rotaru-md
    registry_password: "{{ ghcr_token }}"
    drain_seconds: 32

    # ── appsettings.override.json override ────────────────────────────────
    # This dict is rendered as appsettings.override.json and mounted
    # read-only into the container.  .NET merges it on top of the
    # appsettings.json baked into the image (DOTNET_ENVIRONMENT=Production).
    # Put connection strings, secrets, and env-specific URLs here.
    # Secrets (passwords, API keys) should reference vault.yml variables.
    # Npgsql keeps one pool per unique connection string; Maximum Pool Size
    # caps each pool. Per-app budget: 18+8+2 = 28 connections worst case, so
    # ~4 apps sharing one Postgres stay inside max_connections = 128.
    # Keepalive=60 lets the pool detect and evict connections killed by a
    # Postgres restart (container recreate, minor image update) before
    # requests trip over them.
    appsettings_override:
      ConnectionStrings:
        App:            "Host={{ postgres_host }};Port=5432;Database=waa_ro_app;Username={{ postgres_user }};Password={{ postgres_password }};Pooling=true;Keepalive=60;Maximum Pool Size=18"
        Users:          "Host={{ postgres_host }};Port=5432;Database=waa_ro_users;Username={{ postgres_user }};Password={{ postgres_password }};Pooling=true;Keepalive=60;Maximum Pool Size=8"
        DataProtection: "Host={{ postgres_host }};Port=5432;Database=waa_ro_dp;Username={{ postgres_user }};Password={{ postgres_password }};Pooling=true;Keepalive=60;Maximum Pool Size=2"
      # FileStorage:
      #   BaseDirectory: "/data/files"
      # UiClient:
      #   BaseUrl: "https://example.com"
    # Deployment identity: APP_PROFILE selects appsettings.{APP_PROFILE}.json — the one file
    # that names hosts, language, market. A deploy-time env var, not a build-time flavor: one
    # image runs as any deployment, and the app fails at boot if the profile is missing.
    # env:
    #   APP_PROFILE: "example.com"

EOF


cat << 'EOF' > ~/app-inventory/hosts.ini
[app]
192.168.0.22 ansible_user=devops ansible_private_key_file=~/.ssh/id_ed25519_devops

# Example with SSH key:
# 1.2.3.4 ansible_user=root ansible_private_key_file=~/.ssh/id_ed25519_devops

EOF


cd ~/src/portable-dotnet-architecture/docker/infra/ansible && \
ansible-playbook playbooks/bootstrap.yml

# If you encrypted ~/app-inventory/group_vars/all/vault.yml with ansible-vault, use:
# ansible-playbook playbooks/bootstrap.yml --ask-vault-pass

# The bootstrap playbook also performs the first deploy automatically using image_default.
# Run deploy.sh only for later image updates, for example:
# sudo -u devops /opt/apps/api.waa.ro/scripts/deploy.sh ghcr.io/florin-rotaru-md/waa-server:latest