{% set ram_mb = ansible_facts['memtotal_mb'] | int %}
services:
  postgres:
    image: {{ postgres_image }}
    container_name: postgres
    restart: unless-stopped
    # Same tuning formula as the native role (shared_buffers 25% of RAM,
    # effective_cache_size 75%, tiered work_mem), derived from the docker
    # host's RAM. On this single-host layout Postgres shares that RAM with
    # the app containers — override the postgres_* group_vars if the derived
    # sizes crowd them. max_connections is policy (per-app Npgsql pool
    # budget), not RAM. Values apply on container restart.
    command:
      - postgres
      - -c
      - max_connections={{ postgres_max_connections | default(128) }}
      - -c
      - shared_buffers={{ postgres_shared_buffers | default((ram_mb // 4) ~ 'MB', true) }}
      - -c
      - effective_cache_size={{ postgres_effective_cache_size | default((ram_mb * 3 // 4) ~ 'MB', true) }}
      - -c
      - work_mem={{ postgres_work_mem | default('64MB' if ram_mb >= 49152 else '32MB', true) }}
      - -c
      - maintenance_work_mem={{ postgres_maintenance_work_mem | default('2GB' if ram_mb >= 49152 else '1GB', true) }}
      - -c
      - max_wal_size={{ postgres_max_wal_size | default('4GB', true) }}
      - -c
      - random_page_cost={{ postgres_random_page_cost | default('1.1', true) }}
      - -c
      - effective_io_concurrency={{ postgres_effective_io_concurrency | default('200', true) }}
      - -c
      - wal_compression={{ postgres_wal_compression | default('lz4', true) }}
      # Observability and safety valves, same set as the native role's
      # tuning.conf.j2 — read the comments there for why each one earns its
      # cost. pg_stat_statements also needs CREATE EXTENSION once, from any
      # database on this server:
      #   docker compose exec postgres psql -U postgres \
      #     -c 'CREATE EXTENSION IF NOT EXISTS pg_stat_statements'
      - -c
      - shared_preload_libraries={{ postgres_shared_preload_libraries | default('pg_stat_statements', true) }}
      - -c
      - pg_stat_statements.max={{ postgres_pg_stat_statements_max | default(5000) }}
      - -c
      - pg_stat_statements.track=top
      - -c
      - log_min_duration_statement={{ postgres_log_min_duration_statement | default('1000', true) }}
      - -c
      - log_lock_waits=on
      - -c
      - log_temp_files={{ postgres_log_temp_files | default('8MB', true) }}
      - -c
      - idle_in_transaction_session_timeout={{ postgres_idle_in_transaction_session_timeout | default('5min', true) }}
    env_file:
      - /opt/postgres/docker/postgres.env
    environment:
      PGDATA: /var/lib/postgresql/data
    volumes:
      - postgres_data:/var/lib/postgresql
      - /opt/postgres/backups:/backups
    networks:
      - {{ app_network_name }}
    ports:
      - "127.0.0.1:5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout:  5s
      retries:  5
      start_period: 20s

volumes:
  postgres_data:

networks:
  {{ app_network_name }}:
    external: true
