services:
  postgres:
    image: {{ postgres_image }}
    container_name: postgres
    restart: unless-stopped
    env_file:
      - /opt/postgres/docker/postgres.env
    environment:
      PGDATA: /var/lib/postgresql/data
    volumes:
      - postgres_data:/var/lib/postgresql
      - /opt/postgres/backups:/backups
    networks:
      - {{ app_network_name }}
    ports:
      - "127.0.0.1:5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout:  5s
      retries:  5
      start_period: 20s

volumes:
  postgres_data:

networks:
  {{ app_network_name }}:
    external: true
