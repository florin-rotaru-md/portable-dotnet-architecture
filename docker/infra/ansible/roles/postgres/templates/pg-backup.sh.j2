#!/usr/bin/env bash
# Nightly backup — dumps every user database individually, then cleans up old backups.
set -euo pipefail

BACKUP_DIR="/opt/postgres/backups"
RETENTION_DAYS="{{ backup_retention_days }}"
STAMP="$(date +%Y%m%d-%H%M%S)"

# List all non-template, non-system databases
DATABASES=$(docker exec postgres \
  psql -U postgres -tAc \
  "SELECT datname FROM pg_database WHERE datistemplate = false AND datname NOT IN ('postgres')")

# Ownership and ACLs are deliberately kept. A dump that records the real owner
# is strictly more faithful than one that discards it, and it costs nothing
# while every database is owned by the postgres superuser: the dump simply
# writes `postgres` and the restore reproduces it. --no-owner --no-acl would
# throw that away for no gain, and would become an active defect the day any
# database is owned by something else, turning a restore into a database with
# no owner and no grants that the application cannot write to, discovered at
# the drill rather than at the restore.
#
# --no-owner belongs on the RESTORE side instead, and only when the target
# deliberately lacks the source's roles — a load-drill or analysis box. A
# restore meant to replace production must not pass it.
for DB in $DATABASES; do
  DEST="${BACKUP_DIR}/${DB}_${STAMP}.sql.gz"
  echo "[$(date -Iseconds)] Backing up ${DB} → ${DEST}"
  docker exec postgres pg_dump -U postgres "$DB" \
    | gzip > "$DEST"
  chmod 600 "$DEST"
done

# Prune backups older than retention period
find "$BACKUP_DIR" -name "*.sql.gz" -mtime +"$RETENTION_DAYS" -delete

echo "[$(date -Iseconds)] Backup complete — $(echo "$DATABASES" | wc -w) database(s)"
