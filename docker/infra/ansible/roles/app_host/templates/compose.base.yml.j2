services:
  {{ app.name }}-blue:
    image: ${APP_IMAGE}
    container_name: {{ app.name }}-blue
    restart: unless-stopped
    env_file:
      - {{ apps_root }}/{{ app.name }}/env/common.env
      - {{ apps_root }}/{{ app.name }}/env/blue.env
    volumes:
      - {{ apps_root }}/{{ app.name }}/config/appsettings.override.json:/app/appsettings.override.json:ro
    stop_signal: SIGTERM
    stop_grace_period: 60s
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:{{ app.internal_port }}/.well-known/live || exit 1"]
      interval: 3s
      timeout:  3s
      retries:  7
      start_period: 16s
    networks:
      - {{ app_network_name }}

  {{ app.name }}-green:
    image: ${APP_IMAGE}
    container_name: {{ app.name }}-green
    restart: unless-stopped
    env_file:
      - {{ apps_root }}/{{ app.name }}/env/common.env
      - {{ apps_root }}/{{ app.name }}/env/green.env
    volumes:
      - {{ apps_root }}/{{ app.name }}/config/appsettings.override.json:/app/appsettings.override.json:ro
    stop_signal: SIGTERM
    stop_grace_period: 60s
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:{{ app.internal_port }}/.well-known/live || exit 1"]
      interval: 3s
      timeout:  3s
      retries:  7
      start_period: 16s
    networks:
      - {{ app_network_name }}

networks:
  {{ app_network_name }}:
    external: true
