---
# ── Infrastructure ─────────────────────────────────────────────────────────────
app_user: devops
apps_root:        /opt/apps
app_network_name: app_net
health_max_attempts: 16
health_interval_seconds: 4
# Global defaults used for all apps unless overridden per-app in applications[].

# ── Postgres (runs as a Docker container on the same host) ─────────────────────
# Minor upgrades: the tag pins major.postgis (18-3.6) and the compose task uses
# pull: always, so every playbook run re-pulls the latest 18.x patch and
# recreates the container if it changed. There is no unattended path here by
# design — auto-recreating a database container without an operator watching is
# not worth the risk. Majors are a deliberate act: new tag + dump/restore.
postgres_image:     "postgis/postgis:18-3.6"
postgres_host:      postgres          # Docker service name / internal DNS
postgres_user:      appuser
# postgres_password and postgres_root_password come from vault.yml
backup_retention_days: 7

# ── Postgres tuning (compose command -c flags) ────────────────────────────────
# max_connections is policy, not RAM: it follows the Maximum Pool Size caps in
# the connection strings, and the window that sizes it is a deploy, not rush
# hour:
#
#   steady     = the sum, over every deployment sharing this cluster, of that
#                deployment's own per-instance pools
#   worst case = steady + the largest single deployment's pools, because for
#                the length of a deploy the outgoing and incoming instances of
#                that one deployment both hold their own (a blue/green drain,
#                a rolling update — the same window)
#
# read against max_connections less superuser_reserved_connections (Postgres'
# default is 3), with headroom left for psql/monitoring/backup. Not one
# per-instance total multiplied by an application count and doubled, which this
# file used to say: that charges the smallest deployment at the largest one's
# size and assumes every application drains at the same moment. That all-drain
# sum is worth computing as a secondary check; it is not the verdict.
#
# Deploys taken one at a time are what make the worst case the worst case, and
# that stays an honour system: whatever serialises deploys does, not the
# database. A per-deployment non-superuser role with its own CONNECTION LIMIT
# is what would enforce it. Where every deployment instead connects as
# postgres, a superuser, both superuser_reserved_connections and
# ALTER DATABASE ... CONNECTION LIMIT are unenforced and the starvation hole is
# open: one application can take every slot on the server, starve the others
# and lock the operator out of the database it saturated. Subtracting the
# reserve keeps the budget conservative rather than reserving anything from
# anybody; the only cap that binds is Maximum Pool Size on each connection
# string, which is client-side and always enforced.
#
# A RAM upgrade does not move it; another deployment does. The live estate's
# own worked table lives in the live inventory and in native/example;
# perf/load-drill.sh recomputes it from scenarios/endpoints.json and fails the
# run when it stops fitting.
postgres_max_connections: 400

# Everything else derives from the docker host's RAM on every playbook run
# (shared_buffers 25%, effective_cache_size 75%, work_mem and
# maintenance_work_mem step up at 48GB). Postgres shares this host with the
# app containers, so override when the derived sizes crowd them:
# postgres_shared_buffers:           "2GB"
# postgres_effective_cache_size:     "6GB"
# postgres_work_mem:                 "32MB"
# postgres_maintenance_work_mem:     "1GB"
# postgres_max_wal_size:             "4GB"
# postgres_random_page_cost:         "1.1"
# postgres_effective_io_concurrency: "200"
# postgres_wal_compression:          "lz4"

# Nightly dump schedule (cron on the host).
postgres_backup_hour:   "2"
postgres_backup_minute: "30"

# ── Cloudflare (optional) ──────────────────────────────────────────────────────
use_cloudflared: false
# cloudflare_token comes from vault.yml when use_cloudflared: true

# Connector version. Pinned deliberately: the service runs with --no-autoupdate and
# nothing upgrades it on its own. Bump this and re-run the playbook; rolling back is
# the same bump in reverse. Left unset you get whatever the repository offers.
# cloudflared_version: "2026.8.2"

# ── Ansible service account ────────────────────────────────────────────────────
ansible_user: devops
# ansible_ssh_public_key comes from vault.yml — paste your controller's public key there

# Additional authorized keys (workstation, break-glass kept offline). One key is
# a single point of failure.
# ansible_ssh_extra_public_keys:
#   - "ssh-ed25519 AAAA... workstation"
#   - "ssh-ed25519 AAAA... break-glass"

# The list must also contain every key that was seeded OUTSIDE Ansible and is
# still a way in — a hypervisor's root key, an installer-imported key. Those
# don't feel like "identities", which is exactly why the first exclusive run
# deletes them and takes the get-in-from-the-host path with it.

# Once EVERY key you rely on is listed above, flip to true: keys not in the list
# are removed on the next run — rotating a compromised key = one playbook run.
# Check what is actually authorized first:
#   ansible all -m command -a 'cat ~/.ssh/authorized_keys' -b --become-user devops
ssh_authorized_keys_exclusive: false

# The common role pins PasswordAuthentication no in sshd — a provider console
# password never opens password auth over SSH.
ssh_disable_password_auth: true

# The common role grows the root partition/LVM/filesystem into whatever disk the
# hypervisor granted — a no-op when nothing changed. LVM layouts only: cloud-image
# guests have root on a plain partition that cloud-init grows at every boot —
# set false there (proxmox-lab Stage 11).
grow_root_filesystem: true

# ── Firewall ───────────────────────────────────────────────────────────────────
ufw_allowed_tcp_ports:
  - "22"
  - "80"
  - "443"

# ── Applications ───────────────────────────────────────────────────────────────
# Add one entry per application.
# For public GHCR images, image_default is enough.
# For private images, also set registry_server / registry_username here
# and put registry_password in vault.yml (for example: "{{ ghcr_token }}").
applications:
  - name:          myapp
    server_name:   myapp.example.com
    blue_port:     18081
    green_port:    18082
    internal_port: 8080
    image_default: ghcr.io/example/myapp:latest
    # Optional per-app override:
    # health_max_attempts: 16
    # health_interval_seconds: 4
    # registry_server: ghcr.io
    # registry_username: your-github-username
    # registry_password: "{{ ghcr_token }}"
    drain_seconds: 32

    # ── appsettings.override.json override ────────────────────────────────
    # This dict is rendered as appsettings.override.json and mounted
    # read-only into the container.  .NET merges it on top of the
    # appsettings.json baked into the image (DOTNET_ENVIRONMENT=Production).
    # Put connection strings, secrets, and env-specific URLs here.
    # Secrets (passwords, API keys) should reference vault.yml variables.
    # Npgsql keeps one pool per unique connection string; Maximum Pool Size
    # caps each pool. Per-app budget: 64+16+2 = 82 connections worst case, and
    # a blue/green drain doubles it — postgres_max_connections above carries
    # the arithmetic. The pool is a ceiling, not a target: Npgsql opens
    # connections on demand, and past what the database can execute at once a
    # larger pool only moves the queue from the application into Postgres,
    # where every query slows down instead of some of them waiting.
    # Keepalive=60 lets the pool detect and evict connections killed by a
    # Postgres restart (container recreate, minor image update) before
    # requests trip over them. Timeout=5 fails a request that cannot get a
    # connection rather than pinning a Kestrel thread for the default 15s;
    # Command Timeout=30 bounds one bad query; Connection Idle Lifetime=60
    # hands slots back four minutes sooner than the default, which is what
    # keeps the drain window's worst case theoretical.
    appsettings_override:
      ConnectionStrings:
        App:            "Host={{ postgres_host }};Port=5432;Database=myapp_db;Username={{ postgres_user }};Password={{ postgres_password }};Pooling=true;Keepalive=60;Maximum Pool Size=64;Timeout=5;Command Timeout=30;Connection Idle Lifetime=60"
      #   Users:          "Host={{ postgres_host }};Port=5432;Database=myapp_users;Username={{ postgres_user }};Password={{ postgres_password }};Pooling=true;Keepalive=60;Maximum Pool Size=16;Timeout=5;Command Timeout=30;Connection Idle Lifetime=60"
      #   DataProtection: "Host={{ postgres_host }};Port=5432;Database=myapp_dp;Username={{ postgres_user }};Password={{ postgres_password }};Pooling=true;Keepalive=60;Maximum Pool Size=2;Timeout=5;Command Timeout=30;Connection Idle Lifetime=60"
      # FileStorage:
      #   BaseDirectory: "/data/files"
      # UiClient:
      #   BaseUrl: "https://example.com"
    # Deployment identity: APP_PROFILE selects appsettings.{APP_PROFILE}.json — the one file
    # that names hosts, language, market. A deploy-time env var, not a build-time flavor: one
    # artifact runs as any deployment, and the app fails at boot if the profile is missing.
    # env:
    #   APP_PROFILE: "example.com"

  # - name:          anotherapp
  #   server_name:   anotherapp.example.com
  #   blue_port:     18091
  #   green_port:    18092
  #   internal_port: 8080
  #   image_default: ghcr.io/example/anotherapp:latest
  #   health_max_attempts: 16
  #   health_interval_seconds: 4
  #   registry_server: ghcr.io
  #   registry_username: your-github-username
  #   registry_password: "{{ ghcr_token }}"
  #   drain_seconds: 32
  #   appsettings_override:
  #     ConnectionStrings:
  #       App: "Host={{ postgres_host }};Port=5432;Database=anotherapp_db;Username={{ postgres_user }};Password={{ postgres_password }};Pooling=true;Keepalive=60;Maximum Pool Size=64;Timeout=5;Command Timeout=30;Connection Idle Lifetime=60"
