---
# Copy to vault.yml and fill in values.
# Encrypt with: ansible-vault encrypt vault.yml

# Controller public key installed into the service account's authorized_keys
ansible_ssh_public_key: "{{ lookup('file', '~/.ssh/id_ed25519_devops.pub') }}"

# Additional authorized keys — workstation, break-glass kept offline.
# See ssh_authorized_keys_exclusive in main.yml for declarative rotation.
# ansible_ssh_extra_public_keys:
#   - "ssh-ed25519 AAAA... workstation"
#   - "ssh-ed25519 AAAA... break-glass"

postgres_root_password: "change-me-root-password"   # POSTGRES_PASSWORD for the postgres container
postgres_password:       "change-me-app-password"    # password for postgres_user

# Required only for private container registries (for example private GHCR images)
# ghcr_token: "github_pat_xxx"

# Required only when use_cloudflared: true
# cloudflare_token: "eyJhIjoiABCD..."

# ── Application secrets ────────────────────────────────────────────────────────
# Add variables here and reference them in appsettings_override (main.yml).
# Example:
# smtp_password: "change-me"
# revolut_api_key: "change-me"
# jwt_private_key: "change-me"
